        <!-- 4) Transition: confirm-account-opening -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="4. confirm-account-opening" enabled="true">
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
