<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Carrier project, no code of its own. It exists only so `dotnet publish` resolves the dependency
    chain of Microsoft.Data.SqlClient + Dapper the way an operator would gather it for the runtime's
    Scripting:Sandbox:PluginDirectory. ../build-plugins.sh publishes it for a Unix RID (the NuGet
    package's plain lib/ SqlClient is a stub that throws PlatformNotSupportedException; the RID publish
    picks runtimes/unix/lib/) and copies every DLL except this one into ../out/.

    The mapping scripts then use SqlClient and Dapper DIRECTLY — no wrapper assembly — which is the
    shape the platform's users asked for: "mount the driver, write ADO.NET in the script".
    Dapper must stay at the version ScriptPluginLab.Sql uses: both land in the same flat out/.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>ScriptPluginLab.SqlServer</AssemblyName>
    <RootNamespace>ScriptPluginLab.SqlServer</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
    <!-- SqlClient 6.1.1 pulls Pkcs 9.0.4 (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7); lift it to a patched build. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
