<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A script plugin: a DLL a developer drops into the runtime's Scripting:Sandbox:PluginDirectory so
    mapping scripts can reference it (scripts.allowedAssemblies). Built by ../build-plugins.sh, which
    copies this assembly and its third-party dependency (Dapper) into ../out/.

    Npgsql is deliberately NOT copied: the runtime already ships it, and an assembly the host has
    always resolves to the host's copy. Its version here must stay at or below the runtime's
    (vnext Directory.Build.props → Npgsql 10.0.x), or the host copy cannot satisfy the reference.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ScriptPluginLab.Sql</AssemblyName>
    <RootNamespace>ScriptPluginLab.Sql</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="Npgsql" Version="10.0.0" />
  </ItemGroup>

</Project>
