      "description": "Save Payment Configuration",
      "delayMs": null,
      "isActive": true,
      "isSequential": false,
      "folderIndex": null,
      "rules": [
        {
          "conditionField": "body.userId",
          "conditionOperator": "exists",
          "conditionValue": "",
          "statusCode": 201,
          "responseBody": "{\n  \"success\": true,\n  \"scheduleId\": \"{{helpers.guid()}}\",\n  \"userId\": \"{{body.userId}}\",\n  \"amount\": {{body.amount}},\n  \"currency\": \"{{body.currency}}\",\n  \"frequency\": \"{{body.frequency}}\",\n  \"startDate\": \"{{body.startDate}}\",\n  \"endDate\": \"{{body.endDate}}\",\n  \"paymentMethodId\": \"{{body.paymentMethodId}}\",\n  \"description\": \"{{body.description}}\",\n  \"recipientId\": \"{{body.recipientId}}\",\n  \"isAutoRetry\": {{body.isAutoRetry}},\n  \"maxRetries\": {{body.maxRetries}},\n  \"status\": \"inactive\",\n  \"nextPaymentDate\": \"{{date_time_add_fmt (now) 1 'days' 'yyyy-MM-dd HH:mm'}}\",\n  \"createdAt\": \"{{now}}\",\n  \"maxPayments\": 4\n}",
          "contentType": "application/json",
          "priority": 0,
          "responseHeaders": []
        },
        {
          "conditionField": "body.userId",
          "conditionOperator": "notExists",
          "conditionValue": "",
          "statusCode": 400,
          "responseBody": "{\n  \"success\": false,\n  \"error\": \"Invalid payment configuration\",\n  \"errorCode\": \"invalid_payment_config\",\n  \"details\": \"Missing or invalid parameters\"\n}",
          "contentType": "application/json",
          "priority": 1,
          "responseHeaders": []
        }
