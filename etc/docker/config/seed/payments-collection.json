      "isActive": true,
      "isSequential": false,
      "folderIndex": null,
      "rules": [
        {
          "conditionField": "body.amount",
          "conditionOperator": "greaterThan",
          "conditionValue": "0",
          "statusCode": 200,
          "responseBody": "{\n  \"success\": true,\n  \"transactionId\": \"txn_{{helpers.guid()}}\",\n  \"scheduleId\": \"{{request.body.scheduleId}}\",\n  \"amount\": {{request.body.amount}},\n  \"currency\": \"{{request.body.currency}}\",\n  \"paymentMethod\": \"card\",\n  \"processedAt\": \"{{now}}\",\n  \"fees\": {\n    \"amount\": {{faker 'number.float' 0.5 5.0 2}},\n    \"currency\": \"{{request.body.currency}}\"\n  },\n  \"status\": \"completed\"\n}",
          "contentType": "application/json",
          "priority": 0,
          "responseHeaders": []
        },
        {
          "conditionField": "body.amount",
          "conditionOperator": "equals",
          "conditionValue": "1000",
          "statusCode": 402,
          "responseBody": "{\n  \"success\": false,\n  \"error\": \"Insufficient balance\",\n  \"errorCode\": \"insufficient_funds\",\n  \"amount\": {{request.body.amount}},\n  \"availableBalance\": {{faker 'number.float' 0 100 2}}\n}",
          "contentType": "application/json",
          "priority": 1,
          "responseHeaders": []
        }
