@baseUrl = http://localhost:4201
@apiVersion = 1
@domain = core
@workflow = instance-management-test-workflow

###############################################################################
# TEST 1: Create multiple instances (categories / priorities) and move states
# Instance 1: active-state (finance, 1)
# Instance 2: processing-state (finance, 2) after "process"
# Instance 3: completed-state (hr, 1) after "fast-complete"
###############################################################################

### Instance 1: category finance, priority 1 (remains active)
# @name createInstanceMgmt1
POST {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/start?sync=true
Content-Type: application/json

{
  "key": "instance-mgmt-filter-1-{{$timestamp}}",
  "tags": ["integration-test", "instance-management"],
  "attributes": {
    "category": "finance",
    "priority": 1
  }
}

@instanceMgmtId1 = {{createInstanceMgmt1.response.body.$.id}}

### Instance 2: category finance, priority 2 -> processing-state
# @name createInstanceMgmt2
POST {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/start?sync=true
Content-Type: application/json

{
  "key": "instance-mgmt-filter-2-{{$timestamp}}",
  "tags": ["integration-test", "instance-management"],
  "attributes": {
    "category": "finance",
    "priority": 2
  }
}

@instanceMgmtId2 = {{createInstanceMgmt2.response.body.$.id}}

### Instance 2: move to processing-state
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{instanceMgmtId2}}/transitions/process?sync=true
Content-Type: application/json

{}

### Instance 3: category hr, priority 1 -> completed-state (fast path)
# @name createInstanceMgmt3
POST {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/start?sync=true
Content-Type: application/json

{
  "key": "instance-mgmt-filter-3-{{$timestamp}}",
  "tags": ["integration-test", "instance-management"],
  "attributes": {
    "category": "hr",
    "priority": 1
  }
}

@instanceMgmtId3 = {{createInstanceMgmt3.response.body.$.id}}

### Instance 3: complete from active-state
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{instanceMgmtId3}}/transitions/fast-complete?sync=true
Content-Type: application/json

{}

###############################################################################
# TEST 2: List / filter / sort / pagination
###############################################################################

### Filter by category (finance) — GraphQL / JSON filter (recommended)
### Decoded: filter={"attributes":{"category":{"eq":"finance"}}}
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances?filter=%7B%22attributes%22%3A%7B%22category%22%3A%7B%22eq%22%3A%22finance%22%7D%7D%7D

### Filter by state key — GraphQL / JSON filter
### Decoded: filter={"currentState":{"eq":"active-state"}}
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances?filter=%7B%22currentState%22%3A%7B%22eq%22%3A%22active-state%22%7D%7D

### Filter by status (active) — GraphQL / JSON filter
### Decoded: filter={"status":{"eq":"A"}}
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances?filter=%7B%22status%22%3A%7B%22eq%22%3A%22A%22%7D%7D

### Sort descending by createdAt
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances?sort=-createdAt

### Pagination
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances?page=1&pageSize=2

###############################################################################
# TEST 3: Idempotent start (same business key twice -> same instance id)
###############################################################################

### First start with fixed key
# @name idempotentStart1
POST {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/start?sync=true
Content-Type: application/json

{
  "key": "instance-mgmt-idempotent-key",
  "tags": ["integration-test", "instance-management", "idempotent"],
  "attributes": {
    "category": "finance",
    "priority": 1
  }
}

@idempotentInstanceId1 = {{idempotentStart1.response.body.$.id}}

### Second start with same key (should return same instance)
# @name idempotentStart2
POST {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/start?sync=true
Content-Type: application/json

{
  "key": "instance-mgmt-idempotent-key",
  "tags": ["integration-test", "instance-management", "idempotent"],
  "attributes": {
    "category": "hr",
    "priority": 9
  }
}

@idempotentInstanceId2 = {{idempotentStart2.response.body.$.id}}

### Compare: idempotentInstanceId1 should equal idempotentInstanceId2
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{idempotentInstanceId1}}/functions/state

###############################################################################
# TEST 4: Instance data endpoint
###############################################################################

GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{instanceMgmtId1}}/functions/data

###############################################################################
# TEST 5: subType 4 — suspended-state (start → process → suspend)
###############################################################################

### Start instance for subType 4 path
# @name createInstanceSubtypeSuspended
POST {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/start?sync=true
Content-Type: application/json

{
  "key": "instance-mgmt-subtype-4-{{$timestamp}}",
  "tags": ["integration-test", "instance-management", "subtype-suspended"],
  "attributes": {
    "category": "finance",
    "priority": 1
  }
}

@subtypeSuspendedInstanceId = {{createInstanceSubtypeSuspended.response.body.$.id}}

### Move to processing-state
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{subtypeSuspendedInstanceId}}/transitions/process?sync=true
Content-Type: application/json

{}

### Suspend → suspended-state (subType 4)
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{subtypeSuspendedInstanceId}}/transitions/suspend?sync=true
Content-Type: application/json

{}

### Verify state is suspended-state (check response: current state / effective state)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{subtypeSuspendedInstanceId}}/functions/state

###############################################################################
