###############################################################################
# TEST 7: subType 6 — human-state (start → process → assign-human)
###############################################################################

### Start instance for subType 6 path
# @name createInstanceSubtypeHuman
POST {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/start?sync=true
Content-Type: application/json

{
  "key": "instance-mgmt-subtype-6-{{$timestamp}}",
  "tags": ["integration-test", "instance-management", "subtype-human"],
  "attributes": {
    "category": "finance",
    "priority": 1
  }
}

@subtypeHumanInstanceId = {{createInstanceSubtypeHuman.response.body.$.id}}

### Move to processing-state
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{subtypeHumanInstanceId}}/transitions/process?sync=true
Content-Type: application/json

{}

### Assign human → human-state (subType 6)
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{subtypeHumanInstanceId}}/transitions/assign-human?sync=true
Content-Type: application/json

{}

### Verify state is human-state
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{subtypeHumanInstanceId}}/functions/state
