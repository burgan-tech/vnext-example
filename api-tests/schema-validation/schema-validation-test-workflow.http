# =============================================================================
# [Fact] UpdateData_InSubflow_WithValidSchema_UpdatesAttributes
# confirm → enter-subflow → (bekleme gerekebilir) → update-with-schema notes
# C# notes metni: "Updated via schema-validated updateData"
# Son: GET instance — eTag degisimi ve attributes.notes teyit
# =============================================================================

### UD.1 Baslat
# @name udStart
POST {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/start?sync=true
Content-Type: application/json

{
  "key": "schema-ud-{{$timestamp}}",
  "tags": ["integration-test", "schema-validation", "subflow"],
  "attributes": {
    "orderId": "ORD-UD",
    "customerName": "SubFlow Test",
    "amount": 2000,
    "currency": "TRY"
  }
}

@udInstanceId = {{udStart.response.body.$.id}}

### UD.2 confirm-with-schema
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{udInstanceId}}/transitions/confirm-with-schema?sync=true
Content-Type: application/json

{
  "attributes": {
    "confirmed": true,
    "confirmedBy": "test-admin"
  }
}

### UD.3 enter-subflow
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{udInstanceId}}/transitions/enter-subflow?sync=true
Content-Type: application/json

{}

### UD.4 (istege bagli) effective state — child aktif olana kadar bekleyin
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{udInstanceId}}/functions/state

### UD.5 eTag once (istege bagli)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{udInstanceId}}

### UD.6 update-with-schema — C# ile ayni notes
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{udInstanceId}}/transitions/update-with-schema?sync=true
Content-Type: application/json

{
  "attributes": {
    "notes": "Updated via schema-validated updateData"
  }
}

### UD.7 eTag sonra + attributes.notes
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{udInstanceId}}


