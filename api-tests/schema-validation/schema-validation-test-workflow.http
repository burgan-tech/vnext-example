@baseUrl = http://localhost:4201
@apiVersion = 1
@domain = core
@workflow = schema-validation-test-workflow

###############################################################################
# schema-validation-test-workflow — API manual / REST Client tests
#
# Kaynak: tests/Core/Tests/schema-validation-test-workflow/SchemaValidationTestWorkflowTests.cs
# Yardimci: SchemaValidationScenarioActions.cs, SchemaValidationInstanceDataAssertions.cs
#
# GECIS BODY: Tum PATCH isteklerinde gecis payload'u { "attributes": { ... } } zarfinda
#             olmali (C# WorkflowInstanceTestHelper / RunTransitionAsync ile ayni).
#
# BEKLENTILER (runtime surumune gore):
# - Bazi schema ihlalleri: HTTP 4xx + mesajda "schema validation failed" (C# HttpRequestException).
# - Bazi eski "sessiz red" senaryolari: 200 ama state degismez — dokumantasyona bakin.
#
# Alan adlari (Initialized): orderId, customerName, amount, currency, status="initialized"
# (Initialized tam teyit: GET .../instances/{id} → attributes)
###############################################################################


# =============================================================================
# [Fact] HappyPath_FullChain_CompletesWithStatusC
# Senaryo: SchemaValidationScenarioActions.RunFullHappyPathAsync
#   start → confirm-with-schema → to-no-schema → complete-schema-validation-test
# Son: completed-state, status C
# =============================================================================

### HP.1 Baslat (gecerli master + start schema)
# @name happyStart
POST {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/start?sync=true
Content-Type: application/json

{
  "key": "schema-happy-{{$timestamp}}",
  "tags": ["integration-test", "schema-validation", "schema"],
  "attributes": {
    "orderId": "ORD-001",
    "customerName": "Test Customer",
    "amount": 1500.50,
    "currency": "TRY"
  }
}

@happyInstanceId = {{happyStart.response.body.$.id}}

### HP.2 State: data-initialized
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{happyInstanceId}}/functions/state

### HP.3 confirm-with-schema (ConfirmWithSchemaAsync → confirmedBy default "test-admin")
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{happyInstanceId}}/transitions/confirm-with-schema?sync=true
Content-Type: application/json

{
  "attributes": {
    "confirmed": true,
    "confirmedBy": "test-admin"
  }
}

### HP.4 State: schema-validated-state
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{happyInstanceId}}/functions/state

### HP.5 to-no-schema
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{happyInstanceId}}/transitions/to-no-schema?sync=true
Content-Type: application/json

{}

### HP.6 complete-schema-validation-test
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{happyInstanceId}}/transitions/complete-schema-validation-test?sync=true
Content-Type: application/json

{}

### HP.7 Final: completed-state, status C
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{happyInstanceId}}/functions/state


# =============================================================================
