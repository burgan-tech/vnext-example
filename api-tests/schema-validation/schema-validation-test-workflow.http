###############################################################################
# TEST 10: SubFlow + UpdateData Schema (happy + invalid)
# Tests: SubFlow state'te updateData schema validasyonu
###############################################################################

### Adim 1: Instance Baslat
# @name createSubflowInstance
POST {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/start?sync=true
Content-Type: application/json

{
  "key": "schema-subflow-{{$timestamp}}",
  "tags": ["integration-test", "schema-validation", "subflow-updatedata"],
  "attributes": {
    "orderId": "ORD-SUBFLOW-001",
    "customerName": "SubFlow Test",
    "amount": 2000,
    "currency": "TRY"
  }
}

@subflowInstanceId = {{createSubflowInstance.response.body.$.id}}

### Adim 2: confirm-with-schema ile gecis
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{subflowInstanceId}}/transitions/confirm-with-schema?sync=true
Content-Type: application/json

{
  "attributes": {
    "confirmed": true,
    "confirmedBy": "test-admin"
  }
}

### Adim 3: SubFlow state'e gec
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{subflowInstanceId}}/transitions/enter-subflow?sync=true
Content-Type: application/json

{}

### Adim 4: Durum Kontrol (subflow-state olmali)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{subflowInstanceId}}/functions/state

### Adim 5: UpdateData ile EKSIK required alan (notes yok) — reddedilmeli
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{subflowInstanceId}}/transitions/update-with-schema?sync=true
Content-Type: application/json

{
  "attributes": {
    "someOtherField": "not notes"
  }
}

### Adim 6: Durum Kontrol (hala subflow-state olmali, eTag degismemeli)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{subflowInstanceId}}/functions/state

### Adim 7: UpdateData ile GECERLI payload (notes min 3 karakter)
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{subflowInstanceId}}/transitions/update-with-schema?sync=true
Content-Type: application/json

{
  "attributes": {
    "notes": "Valid update data notes"
  }
}

### Adim 8: Instance Body Kontrol (eTag degismis olmali)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{subflowInstanceId}}
