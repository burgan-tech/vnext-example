@baseUrl = http://localhost:4201
@apiVersion = 1
@domain = core
@workflow = view-function-extension-test-workflow

### Step 1: Start Workflow Instance
# @name createInstance
POST {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/start
Content-Type: application/json

{
  "key": "vfe-test-{{$timestamp}}",
  "tags": ["integration-test", "view-function-extension"],
  "attributes": {}
}

@instanceId = {{createInstance.response.body.$.id}}

### Step 2: Get State (view-test-state — JSON view, stateType 1)
# Instance stays in view-test-state (no auto transition)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{instanceId}}/functions/state

### Step 3: Get View (view-test-state — type 1 JSON, display full-page)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{instanceId}}/functions/view

### Step 4: Instance Data (extensions scope check)
# Type 1 Global (Scope 3 Everywhere): implicit, NOT in workflow extensions — should auto-appear
# Type 2 GlobalAndRequested (Scope 1 GetInstance): appears in default or with ?extensions= query
# Type 3 DefinedFlows (Scope 2 GetAllInstances): appears in list endpoint enrichment
# Type 4 DefinedFlowAndRequested (Scope 3 Everywhere): appears only with ?extensions= query
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{instanceId}}/functions/data

### Step 5: Data with GlobalAndRequested extension (Type 2, Scope 1)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{instanceId}}/functions/data?extensions=vfe-global-and-requested-extension

### Step 6: Data with DefinedFlowAndRequested extension (Type 4, Scope 3)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{instanceId}}/functions/data?extensions=vfe-defined-flow-and-requested-extension

### Step 7: List Instances (Scope 2 GetAllInstances enrichment test)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances?pageSize=10

### Step 8: Single-Task Function (scope I — Instance)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{instanceId}}/functions/vfe-single-task-function

### Step 9: Multi-Task Function (scope I — Instance)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{instanceId}}/functions/vfe-multi-task-function

### Step 10: Workflow-Scope Function (scope F)
# NOTE: Runtime may return 404 for workflow-scope functions — known limitation
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/functions/vfe-workflow-function

### Step 11: Domain-Scope Function (scope D)
# NOTE: Runtime may return empty body for domain-scope functions — known limitation
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/functions/vfe-domain-function

### Step 12: Transition continue-to-html (manual, transition view: json-view)
# This transition has a view reference attached — tests transition view rendering
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{instanceId}}/transitions/continue-to-html
Content-Type: application/json

{}

### Step 13: Get State (html-view-state — type 2, popup)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{instanceId}}/functions/state

### Step 14: Get View (html-view-state — type 2, display popup)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{instanceId}}/functions/view

### Step 15: Transition to markdown-view-state
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{instanceId}}/transitions/to-markdown
Content-Type: application/json

{}

### Step 16: Get State (markdown-view-state)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{instanceId}}/functions/state

### Step 17: Get View (markdown-view-state — type 3, display bottom-sheet)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{instanceId}}/functions/view

### Step 18: Transition to deeplink-view-state
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{instanceId}}/transitions/to-deeplink
Content-Type: application/json

{}

### Step 19: Get State (deeplink-view-state)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{instanceId}}/functions/state

### Step 20: Get View (deeplink-view-state — type 4, display top-sheet)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{instanceId}}/functions/view

### Step 21: Transition to http-view-state
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{instanceId}}/transitions/to-http
Content-Type: application/json

{}

### Step 22: Get State (http-view-state)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{instanceId}}/functions/state

### Step 23: Get View (http-view-state — type 5, display drawer)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{instanceId}}/functions/view

### Step 24: Transition to urn-view-state
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{instanceId}}/transitions/to-urn
Content-Type: application/json

{}

### Step 25: Get State (urn-view-state — type 6, inline)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{instanceId}}/functions/state

### Step 26: Get View (urn-view-state — type 6, inline)
# NOTE: Runtime may return 404 for URN view type — known limitation
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{instanceId}}/functions/view

### Step 27: Transition to wizard-step-state (stateType 5)
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{instanceId}}/transitions/to-wizard
Content-Type: application/json

{}

### Step 28: Get State (wizard-step-state — stateType 5, transition view rendered)
# Wizard state: exactly 1 transition, no state view, transition view rendered
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{instanceId}}/functions/state

### Step 29: Complete Workflow
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{instanceId}}/transitions/complete
Content-Type: application/json

{}

### Step 30: Get Final State (completed-state, status: C)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{instanceId}}/functions/state
