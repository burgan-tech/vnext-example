@baseUrl = http://localhost:4201
@apiVersion = 1
@domain = core
@workflow = view-function-extension-test-workflow

###############################################################################
# View, function, and extension integration tests.
# Workflow path: view-test-state → (auto) multi-view-state → (manual)
#   wizard-state → (manual) completed-state
###############################################################################

### Step 1: Start workflow (sync) — lands on view-test-state, auto-transitions to multi-view-state
# @name createVfeInstance
POST {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/start?sync=true
Content-Type: application/json

{
  "key": "vfe-test-{{$timestamp}}",
  "tags": ["integration-test", "view-function-extension"],
  "attributes": {}
}

@vfeInstanceId = {{createVfeInstance.response.body.$.id}}

### Step 2: Get state — should be multi-view-state (auto-transition fires immediately)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{vfeInstanceId}}/functions/state

### Step 3: Get view payload (state-level HTML view on multi-view-state, optional platform filter)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{vfeInstanceId}}/functions/view?platform=web

### Step 4: Execute single-task function (instance-scoped, script task)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{vfeInstanceId}}/functions/single-task-function

### Step 5: Execute multi-task function (two script tasks; output handler aggregates)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{vfeInstanceId}}/functions/multi-task-function

### Step 6: Instance data without extension filter (global-extension scope Everywhere may apply)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{vfeInstanceId}}/functions/data

### Step 7: Requested extensions via query (DefinedFlowAndRequested + on-demand)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{vfeInstanceId}}/functions/data?extensions=requested-extension,global-extension

### Step 8: Transition to wizard-state (manual-to-wizard)
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{vfeInstanceId}}/transitions/manual-to-wizard
Content-Type: application/json

{}

### Step 9: Verify wizard-state — stateType 5, at most 1 transition, transition has markdown-view
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{vfeInstanceId}}/functions/state

### Step 10: Complete workflow (complete-with-markdown-view transition)
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{vfeInstanceId}}/transitions/complete-with-markdown-view
Content-Type: application/json

{}

### Step 11: Verify completed-state with status C
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{vfeInstanceId}}/functions/state
