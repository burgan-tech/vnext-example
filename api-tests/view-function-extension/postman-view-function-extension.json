{
  "info": {
    "name": "View-Function-Extension Integration Test",
    "_postman_id": "vfe-comprehensive-test",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Comprehensive integration test for view-function-extension-test-workflow.\nCovers 6 view types (JSON/HTML/Markdown/DeepLink/HTTP/URN), 6 display modes (full-page/popup/bottom-sheet/top-sheet/drawer/inline), 4 extension types (Global/GlobalAndRequested/DefinedFlows/DefinedFlowAndRequested), 3 extension scopes (GetInstance/GetAllInstances/Everywhere), 3 function scopes (Instance/Workflow/Domain), transition view rendering, and wizard state (stateType 5) behavior."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4201" },
    { "key": "apiVersion", "value": "1" },
    { "key": "domain", "value": "core" },
    { "key": "workflow", "value": "view-function-extension-test-workflow" },
    { "key": "instanceId", "value": "" }
