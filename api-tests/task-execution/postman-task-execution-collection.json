        {
          "name": "Adim 1: Ana workflow baslat (sync)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
            "url": {
              "raw": "{{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/start?sync=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v{{apiVersion}}", "{{domain}}", "workflows", "{{workflow}}", "instances", "start"],
              "query": [{ "key": "sync", "value": "true" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"task-exec-test-{{$timestamp}}\",\n  \"tags\": [\"integration-test\", \"task-execution\"],\n  \"attributes\": {}\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Adim 1: collection variables — sync start (child id + workflow key)\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData, \"start response\").to.be.ok;",
                  "    pm.expect(jsonData.id, \"parent instance id\").to.be.a(\"string\").and.not.empty;",
                  "    pm.collectionVariables.set(\"taskExecInstanceId\", jsonData.id);",
                  "    var a = jsonData.attributes || {};",
                  "    function optPick(root, attr, keys) {",
                  "        for (var i = 0; i < keys.length; i++) {",
                  "            var k = keys[i];",
                  "            var v = root[k] !== undefined && root[k] !== null ? root[k] : attr[k];",
                  "            if (v !== undefined && v !== null && String(v).length) return String(v);",
                  "        }",
                  "        return \"\";",
                  "    }",
                  "    var started = optPick(jsonData, a, [\"startedInstanceId\"]);",
                  "    var sub = optPick(jsonData, a, [\"subprocessInstanceId\"]);",
                  "    pm.expect(started, \"startedInstanceId (StartFlow child)\").to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(sub, \"subprocessInstanceId (SubProcess child)\").to.be.a(\"string\").and.not.empty;",
                  "    pm.collectionVariables.set(\"taskExecStartedTargetId\", started);",
                  "    pm.collectionVariables.set(\"taskExecSubprocessId\", sub);",
                  "    var timerStartedAt = optPick(jsonData, a, [\"timerStartedAt\"]);",
                  "    pm.expect(timerStartedAt, \"timerStartedAt (Timer Task tip 9 - timer-wait-state)\").to.be.a(\"string\").and.not.empty;",
                  "    var ts = Date.parse(timerStartedAt);",
                  "    pm.expect(isNaN(ts), \"timerStartedAt should be parseable ISO 8601\").to.equal(false);",
                  "    var elapsedMs = Date.now() - ts;",
                  "    pm.expect(elapsedMs, \"sync start oncesinde human-task-state'e ulasilmasi 3 sn'lik scheduled transition'i ortaya cikarmali (>= 2500 ms)\").to.be.at.least(2500);",
                  "    var expectedSeconds = (a && typeof a.timerExpectedSeconds === \"number\") ? a.timerExpectedSeconds : (typeof jsonData.timerExpectedSeconds === \"number\" ? jsonData.timerExpectedSeconds : null);",
                  "    pm.expect(expectedSeconds, \"timerExpectedSeconds attribute (TimerStartMapping)\").to.equal(3);",
                  "    var sfId = optPick(jsonData, a, [\"subflowInstanceId\", \"subFlowInstanceId\", \"childSubFlowInstanceId\"]);",
                  "    if (sfId) pm.collectionVariables.set(\"taskExecSubflowInstanceId\", sfId);",
                  "    var wf1 = optPick(jsonData, a, [\"startFlowTargetWorkflow\", \"startedTargetWorkflowKey\", \"childWorkflowStartFlow\"]);",
                  "    if (wf1) pm.collectionVariables.set(\"childWorkflowStartFlow\", wf1);",
                  "    var wf2 = optPick(jsonData, a, [\"subprocessTargetWorkflow\", \"subprocessWorkflowKey\", \"childWorkflowSubprocess\"]);",
                  "    if (wf2) pm.collectionVariables.set(\"childWorkflowSubprocess\", wf2);",
                  "    var wf3 = optPick(jsonData, a, [\"subflowTargetWorkflow\", \"subflowWorkflowKey\", \"childWorkflowSubflow\"]);",
                  "    if (wf3) pm.collectionVariables.set(\"childWorkflowSubflow\", wf3);",
                  "});"
                ]
              }
            }
          ]
