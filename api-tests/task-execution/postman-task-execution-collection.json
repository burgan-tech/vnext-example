                  "function __attr(p) { return p && p.attributes && typeof p.attributes === \"object\" ? p.attributes : {}; }",
                  "function __pick(p, keys) {",
                  "    var a = __attr(p);",
                  "    for (var i = 0; i < keys.length; i++) {",
                  "        var k = keys[i];",
                  "        var v = p[k] !== undefined && p[k] !== null ? p[k] : a[k];",
                  "        if (v !== undefined && v !== null && String(v).length) return String(v);",
                  "    }",
                  "    return \"\";",
                  "}",
                  "var j = pm.response.json();",
                  "var s1 = __pick(j, [\"startedInstanceId\"]);",
                  "var s2 = __pick(j, [\"subprocessInstanceId\"]);",
                  "var s3 = __pick(j, [\"subflowInstanceId\", \"subFlowInstanceId\", \"childSubFlowInstanceId\"]);",
                  "var w1 = __pick(j, [\"startFlowTargetWorkflow\", \"startedTargetWorkflowKey\", \"childWorkflowStartFlow\"]);",
                  "var w2 = __pick(j, [\"subprocessTargetWorkflow\", \"subprocessWorkflowKey\", \"childWorkflowSubprocess\"]);",
                  "var w3 = __pick(j, [\"subflowTargetWorkflow\", \"subflowWorkflowKey\", \"childWorkflowSubflow\"]);",
                  "if (s1) pm.collectionVariables.set(\"taskExecStartedTargetId\", s1);",
                  "if (s2) pm.collectionVariables.set(\"taskExecSubprocessId\", s2);",
                  "if (s3) pm.collectionVariables.set(\"taskExecSubflowInstanceId\", s3);",
                  "if (w1) pm.collectionVariables.set(\"childWorkflowStartFlow\", w1);",
                  "if (w2) pm.collectionVariables.set(\"childWorkflowSubprocess\", w2);",
                  "if (w3) pm.collectionVariables.set(\"childWorkflowSubflow\", w3);"
                ]
              }
            }
