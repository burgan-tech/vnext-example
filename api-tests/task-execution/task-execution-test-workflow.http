@baseUrl = http://localhost:4201
@apiVersion = 1
@domain = core
@workflow = task-execution-test-workflow
@targetWorkflow = task-target-workflow
@mocklabBaseUrl = http://localhost:3002

###############################################################################
# TEST 1: Full task execution chain
# HTTP task -> Script task -> Cross workflow -> Start Flow (type 11) ->
# Get Instance Data (type 13) -> Completed
# Requires: MocklabBaseUrl config, Mocklab seeded (POST /api/test/process)
###############################################################################

### Adim 1: Ana workflow baslat (sync)
# @name createTaskExecInstance
POST {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/start?sync=true
Content-Type: application/json

{
  "key": "task-exec-test-{{$timestamp}}",
  "tags": ["integration-test", "task-execution"],
  "attributes": {}
}

@taskExecInstanceId = {{createTaskExecInstance.response.body.$.id}}

### Adim 2: Durum kontrol (completed-state beklenir)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{taskExecInstanceId}}/functions/state

### Adim 3: Instance data dogrula
# Beklenen bayraklar: testId, httpTaskCompleted, scriptProcessed,
# crossWorkflowCompleted, startFlowCompleted, startedInstanceId,
# getInstanceDataCompleted, remoteInstanceData
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{taskExecInstanceId}}/functions/data

###############################################################################
# TEST 2: Hedef workflow (task-target-workflow) bagimsiz baslatma
###############################################################################

### Adim 1: Hedef workflow baslat
# @name createTargetInstance
POST {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{targetWorkflow}}/instances/start?sync=true
Content-Type: application/json

{
  "key": "task-target-test-{{$timestamp}}",
  "tags": ["integration-test", "task-execution", "target"],
  "attributes": {}
}

@targetInstanceId = {{createTargetInstance.response.body.$.id}}

### Adim 2: Hedef workflow durumu (target-completed olmali)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{targetWorkflow}}/instances/{{targetInstanceId}}/functions/state
