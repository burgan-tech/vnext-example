@baseUrl = http://localhost:4201
@apiVersion = 1
@domain = core
@workflow = task-execution-test-workflow
@targetWorkflow = task-target-workflow
@extendedWorkflow = extended-tasks-test-workflow
@mocklabBaseUrl = http://localhost:3002

###############################################################################
# vNext Task execution — tek dosya (Postman koleksiyonu ile ayni bolum yapisi)
#
# BOLUM 1 — Ana zincir (task-execution-test-workflow): happy path
# BOLUM 2 — Hedef workflow (task-target-workflow): happy path
# BOLUM 3 — Dapr zinciri (extended-tasks-test-workflow): happy path
###############################################################################

###############################################################################
# BOLUM 1 — Happy path: Ana task execution zinciri
# HTTP -> Script -> Timer Wait (Timer Task tip 9, scheduled transition 3 sn)
# -> Start Flow (11) -> Get Instance Data (13)
# -> Notification (10, mapping.type G) -> TriggerTransition (12) -> SubProcess (14)
# -> GetInstances (15) -> Human Task (5) -> PATCH approve -> Completed
# Condition Task (tip 8) tum auto transition rule'larinda (AlwaysTrueRule) dolayli olarak uretilir.
# Requires: MocklabBaseUrl config, Mocklab seeded (POST /api/test/process)
###############################################################################

### B1 — Adim 1: Ana workflow baslat (sync zincir human-task-state'te durur)
# @name createTaskExecInstance
POST {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/start?sync=true
Content-Type: application/json

{
  "key": "task-exec-test-{{$timestamp}}",
  "tags": ["integration-test", "task-execution"],
  "attributes": {}
}

@taskExecInstanceId = {{createTaskExecInstance.response.body.$.id}}

### B1 — Adim 2: Durum kontrol (human-task-state beklenir)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{taskExecInstanceId}}/functions/state

### B1 — Adim 3: Instance data (notification / trigger / subprocess / getInstances bayraklari)
# Beklenen: testId, httpTaskCompleted, scriptProcessed,
# timerStartedAt (TimerStartMapping anligi - timer-wait-state'e girildigi an),
# timerExpectedSeconds = 3 (TimerScheduleMapping bekleme suresi),
# startFlowCompleted, startedInstanceId (StartTask sonucu hedef workflow id),
# subprocessInstanceId (SubProcessTask sonucu hedef workflow id),
# subprocessData (SubProcessTask context.Body.data anlık kopyası: id/instanceId/state vb.),
# getInstanceDataCompleted, taskResults.triggerTransition.completed,
# taskResults.subprocess.completed, taskResults.getInstances.completed,
# taskResults.humanTask.completed
# Not: human-task-state'e ulasilana kadar gecen toplam sure >= 3 sn olmali; aksi halde
# scheduled transition'in Timer Task'i devre disi olabilir.
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{taskExecInstanceId}}/functions/data

### B1 — Adim 3a: StartTask ile baslatilan hedef instance functions/state (target-completed olmali)
# startedInstanceId'yi B1 Adim 3 cikisindan kopyalayip asagidaki degiskene yapistir.
# (Postman koleksiyonu bunu otomatik degisken olarak set eder.)
@taskExecStartedTargetId = REPLACE_WITH_startedInstanceId
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{targetWorkflow}}/instances/{{taskExecStartedTargetId}}/functions/state

### B1 — Adim 3b: SubProcessTask ile acilan hedef instance functions/state
# Subprocess fire-and-forget'tir; state target-initial (Active) veya target-completed olabilir.
@taskExecSubprocessId = REPLACE_WITH_subprocessInstanceId
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{targetWorkflow}}/instances/{{taskExecSubprocessId}}/functions/state

### B1 — Adim 3c: SubProcessTask ile acilan hedef instance attributes
# Beklenen: source = "task-execution-test", parentInstanceId = ana workflow instance id,
# note alani SubProcessMapping InputHandler'da SetBody ile yazilmali.
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{targetWorkflow}}/instances/{{taskExecSubprocessId}}

### B1 — Adim 4: Human task onayla (manuel transition)
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{taskExecInstanceId}}/transitions/approve-human-task
Content-Type: application/json

{}

### B1 — Adim 5: Durum kontrol (completed-state)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{taskExecInstanceId}}/functions/state

### B1 — Adim 6: Final instance data
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{taskExecInstanceId}}/functions/data

###############################################################################
# BOLUM 2 — Happy path: Hedef workflow (task-target-workflow) bagimsiz baslatma
###############################################################################

### B2 — Adim 1: Hedef workflow baslat
# @name createTargetInstance
POST {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{targetWorkflow}}/instances/start?sync=true
Content-Type: application/json

{
  "key": "task-target-test-{{$timestamp}}",
  "tags": ["integration-test", "task-execution", "target"],
  "attributes": {}
}

@targetInstanceId = {{createTargetInstance.response.body.$.id}}

### B2 — Adim 2: Hedefde manuel gecis (DirectTriggerTask ile ayni anahtar: manual-complete-target)
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{targetWorkflow}}/instances/{{targetInstanceId}}/transitions/manual-complete-target
Content-Type: application/json

{}

### B2 — Adim 3: Hedef workflow durumu (target-completed olmali)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{targetWorkflow}}/instances/{{targetInstanceId}}/functions/state

###############################################################################
# BOLUM 3 — Happy path: Dapr task zinciri (extended-tasks-test-workflow, sadece dis servis)
# Dapr HTTP (1) -> Dapr Service (3) -> Dapr Binding (2) ->
# Dapr PubSub (4) -> completed-state (otomatik)
###############################################################################

### B3 — Adim 1: Workflow baslat (sync - tam zincir)
# @name createExtendedInstance
POST {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{extendedWorkflow}}/instances/start?sync=true
Content-Type: application/json

{
  "key": "extended-tasks-test-{{$timestamp}}",
  "tags": ["integration-test", "task-execution", "dapr-only"],
  "attributes": {
    "testId": "extended-tasks-dapr-path"
  }
}

@extendedInstanceId = {{createExtendedInstance.response.body.$.id}}

### B3 — Adim 2: Durum kontrol - completed-state olmali
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{extendedWorkflow}}/instances/{{extendedInstanceId}}/functions/state

### B3 — Adim 3: Instance - Dapr task sonuclari
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{extendedWorkflow}}/instances/{{extendedInstanceId}}

### B3 — Beklenen sonuclar (yorum):
### - initCompleted: true
### - taskResults.daprHttp.completed: true
### - taskResults.daprService.completed: true
### - taskResults.daprBinding.completed: true
### - taskResults.daprPubSub.completed: true
