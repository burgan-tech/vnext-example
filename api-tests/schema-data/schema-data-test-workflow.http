@baseUrl = http://localhost:4201
@apiVersion = 1
@domain = core
@workflow = schema-data-test-workflow

###############################################################################
# TEST 1: Master Schema + Transition Schema Validation
# Tests: master schema active, transition schema enforcement,
#        onExecutionTasks with mapping after schema passes
###############################################################################

### Adim 1: Workflow Baslat (master schema required alanlarla)
# @name createSchemaInstance
POST {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/start?sync=true
Content-Type: application/json

{
  "key": "schema-test-{{$timestamp}}",
  "tags": ["integration-test", "schema-data"],
  "attributes": {
    "orderId": "ORD-001",
    "customerName": "Test Customer",
    "amount": 1500.50,
    "currency": "TRY"
  }
}

@schemaInstanceId = {{createSchemaInstance.response.body.$.id}}

### Adim 2: Durum Kontrol (data-initialized olmali)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{schemaInstanceId}}/functions/state

### Adim 3: Transition Schema ile Onayla (dogru data)
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{schemaInstanceId}}/transitions/confirm-with-schema?sync=true
Content-Type: application/json

{
  "confirmed": true,
  "confirmedBy": "test-admin"
}

### Adim 4: Durum Kontrol (schema-validated-state olmali)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{schemaInstanceId}}/functions/state

### Adim 5: No-schema state'e gec
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{schemaInstanceId}}/transitions/to-no-schema?sync=true
Content-Type: application/json

{}

### Adim 6: Tamamla
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{schemaInstanceId}}/transitions/complete-schema-test?sync=true
Content-Type: application/json

{}

###############################################################################
# TEST 2: Transition Schema Rejection (Sessiz Red)
# Tests: yanlis data gonderilirse transition 200 doner ama state DEGISMEZ
###############################################################################

### Adim 1: Yeni Instance Baslat
# @name createRejectInstance
POST {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/start?sync=true
Content-Type: application/json

{
  "key": "schema-reject-test-{{$timestamp}}",
  "tags": ["integration-test", "schema-data", "rejection"],
  "attributes": {
    "orderId": "ORD-002",
    "customerName": "Reject Test",
    "amount": 500,
    "currency": "USD"
  }
}

@rejectInstanceId = {{createRejectInstance.response.body.$.id}}

### Adim 2: Transition Schema ile YANLIS data gonder (confirmed ve confirmedBy required)
# Bu 200 donecek ama state DEGISMEMELI (sessiz red)
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{rejectInstanceId}}/transitions/confirm-with-schema?sync=true
Content-Type: application/json

{
  "wrongField": "this does not match schema"
}

### Adim 3: Durum Kontrol (HALA data-initialized olmali - state degismemeli)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{rejectInstanceId}}/functions/state

###############################################################################
# TEST 3: updateData ($self) Transition
# Tests: state degistirmeden instance data guncelleme
###############################################################################

### Adim 1: Yeni Instance Baslat
# @name createUpdateDataInstance
POST {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/start?sync=true
Content-Type: application/json

{
  "key": "schema-updatedata-test-{{$timestamp}}",
  "tags": ["integration-test", "schema-data", "update-data"],
  "attributes": {
    "orderId": "ORD-003",
    "customerName": "UpdateData Test",
    "amount": 750,
    "currency": "EUR"
  }
}

@updateDataInstanceId = {{createUpdateDataInstance.response.body.$.id}}

### Adim 2: Durum Kontrol (data-initialized olmali)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{updateDataInstanceId}}/functions/state

### Adim 3: updateData ($self) ile data guncelle - state degismemeli
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{updateDataInstanceId}}/transitions/update-instance-data?sync=true
Content-Type: application/json

{
  "orderId": "ORD-003",
  "customerName": "UpdateData Test - UPDATED",
  "amount": 800,
  "currency": "EUR"
}

### Adim 4: Durum Kontrol (HALA data-initialized olmali ama data guncellenmis olmali)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{updateDataInstanceId}}/functions/state

### Adim 5: Data kontrol et (guncellenmis data'yi gor)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{updateDataInstanceId}}/functions/data

###############################################################################
# TEST 4: Master Schema Violation at Start
# Tests: master schema zorunlu alan eksik olunca baslatma basarisiz olmali
###############################################################################

### Adim 1: Eksik required alan ile baslat (currency yok)
POST {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/start?sync=true
Content-Type: application/json

{
  "key": "schema-violation-test-{{$timestamp}}",
  "tags": ["integration-test", "schema-data", "violation"],
  "attributes": {
    "orderId": "ORD-004",
    "customerName": "Missing Currency"
  }
}
