{
  "info": {
    "_postman_id": "a1111111-b222-4c33-d444-555566667777",
    "name": "vNext Smoke - Minimal Runtime Check",
    "description": "En basit workflow (smoke-runtime-check-workflow): script yok, auto transition yok, transition rol yok.\nAkis: baslat — durum — finish-smoke PATCH — son durum.\nRuntime PATCH/GET dongusunu yalitmak icin.\nOn kosul: workflow publish (core/smoke-runtime-check-workflow).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4201",
      "type": "string"
    },
    {
      "key": "apiVersion",
      "value": "1",
      "type": "string"
    },
    {
      "key": "domain",
      "value": "core",
      "type": "string"
    },
    {
      "key": "workflow",
      "value": "smoke-runtime-check-workflow",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Minimal smoke (manuel tek gecis)",
      "item": [
        {
          "name": "1 Baslat POST /instances/start ?sync=true",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/start?sync=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v{{apiVersion}}",
                "{{domain}}",
                "workflows",
                "{{workflow}}",
                "instances",
                "start"
              ],
              "query": [
                {
                  "key": "sync",
                  "value": "true"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"smoke-test-{{$timestamp}}\",\n  \"tags\": [\"smoke\", \"minimal\"],\n  \"attributes\": {\n    \"ping\": true\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.id) {",
                  "    pm.collectionVariables.set(\"smokeInstanceId\", jsonData.id);",
                  "    console.log(\"smokeInstanceId:\", jsonData.id);",
                  "} else {",
                  "    console.warn(\"Baslat yaniti id icermiyor\", jsonData);",
                  "}",
                  "pm.test(\"HTTP 200-299\", function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2 GET /functions/state (F olmamali, smoke-start)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{smokeInstanceId}}/functions/state",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v{{apiVersion}}",
                "{{domain}}",
                "workflows",
                "{{workflow}}",
                "instances",
                "{{smokeInstanceId}}",
                "functions",
                "state"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var j = pm.response.json();",
                  "console.log(\"state yaniti\", JSON.stringify(j));",
                  "pm.test(\"status F olmamalidir\", function () {",
                  "    pm.expect(j.status === undefined ? null : String(j.status)).to.not.eql(\"F\");",
                  "});",
                  "var stateKey = (j.effectiveState && j.effectiveState.key) || (j.state && j.state.key) || j.key;",
                  "if (stateKey) { console.log(\"state key:\", stateKey); pm.test(\"smoke-start bekleniyor\", function () { pm.expect(String(stateKey)).to.eql(\"smoke-start\"); }); }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "3 PATCH finish-smoke ?sync=true",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{smokeInstanceId}}/transitions/finish-smoke?sync=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v{{apiVersion}}",
                "{{domain}}",
                "workflows",
                "{{workflow}}",
                "instances",
                "{{smokeInstanceId}}",
                "transitions",
                "finish-smoke"
              ],
              "query": [
                {
                  "key": "sync",
                  "value": "true"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"PATCH 200\", function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "4 GET /functions/state (final smoke-done)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{smokeInstanceId}}/functions/state",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v{{apiVersion}}",
                "{{domain}}",
                "workflows",
                "{{workflow}}",
                "instances",
                "{{smokeInstanceId}}",
                "functions",
                "state"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var j = pm.response.json();",
                  "console.log(\"final state\", JSON.stringify(j));",
                  "pm.test(\"status F olmamalidir\", function () {",
                  "    pm.expect(j.status === undefined ? null : String(j.status)).to.not.eql(\"F\");",
                  "});",
                  "var stateKey = (j.effectiveState && j.effectiveState.key) || (j.state && j.state.key);",
                  "if (stateKey) { pm.test(\"smoke-done final\", function () { pm.expect(String(stateKey)).to.eql(\"smoke-done\"); }); }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
