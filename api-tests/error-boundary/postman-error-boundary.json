            "{{domain}}",
            "workflows",
            "{{workflow}}",
            "instances",
            "{{errorBoundaryInstanceId}}",
            "functions",
            "state"
          ]
        },
        "description": "Tipik sonuç: **state** ≈ `global-abort-test-state`, **status** = `F`. Ara durumlar çok hızlı geçebilir (task-retry-state … notify-test-state)."
