@baseUrl = http://localhost:4201
@apiVersion = 1
@domain = core
@workflow = version-consistency-test-workflow

###############################################################################
# VERSION CONSISTENCY TEST
#
# Validates that when the workflow version changes, existing instances keep
# following the flow pinned to their own definition version.
#
# PREREQUISITE: Only v1.0.0 should be published.
# v2.0.0 must NOT yet be published.
#
# STEPS:
#   1. Publish v1.0.0 workflow (version-consistency-test-workflow.json)
#   2. Start instance A (runs on v1.0.0)
#   3. Move instance A to processing-state (auto)
#   4. Publish v2.0.0 workflow (version-consistency-test-workflow-v2.json)
#   5. Start instance B (runs on v2.0.0)
#   6. Leave instance B on processing-state
#   7. Instance A: complete-processing → completed-state (v1 path, NO review)
#   8. Instance B: complete-processing → review-state (v2 path)
#   9. Instance B: approve-review → completed-state
#  10. Compare data on both instances
###############################################################################

###############################################################################
# STEP 1: v1.0.0 MUST BE PUBLISHED
# → Publish version-consistency-test-workflow.json
###############################################################################

###############################################################################
# STEP 2: Start instance A (v1.0.0 line)
###############################################################################

### Instance A - Start (pinned to v1.0.0)
# @name createInstanceA
POST {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/start?sync=true
Content-Type: application/json

{
  "key": "version-test-A-{{$timestamp}}",
  "tags": ["integration-test", "version-consistency", "v1-instance"],
  "attributes": {
    "testId": "version-consistency-A"
  }
}

@instanceAId = {{createInstanceA.response.body.$.id}}

###############################################################################
# STEP 3: Instance A state check (should be processing-state)
###############################################################################

### Instance A - State check (expect processing-state)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{instanceAId}}/functions/state

###############################################################################
# STEP 4: Publish v2.0.0
# → Publish version-consistency-test-workflow-v2.json
# Instance A remains on processing-state.
###############################################################################

###############################################################################
# STEP 5: Start instance B (v2.0.0 line)
###############################################################################

### Instance B - Start (pinned to v2.0.0)
# @name createInstanceB
POST {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/start?sync=true
Content-Type: application/json

{
  "key": "version-test-B-{{$timestamp}}",
  "tags": ["integration-test", "version-consistency", "v2-instance"],
  "attributes": {
    "testId": "version-consistency-B"
  }
}

@instanceBId = {{createInstanceB.response.body.$.id}}

###############################################################################
# STEP 6: Instance B state check (should be processing-state)
###############################################################################

### Instance B - State check (expect processing-state)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{instanceBId}}/functions/state

###############################################################################
# STEP 7: Complete instance A
# complete-processing → completed-state (v1 path, NO review-state)
###############################################################################

### Instance A - complete-processing (v1: should land on completed-state)
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{instanceAId}}/transitions/complete-processing?sync=true
Content-Type: application/json

{}

### Instance A - Final state (expect completed-state)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{instanceAId}}/functions/state

### Instance A - Data check
# EXPECTED: v1Completed=true; reviewExecuted must NOT appear
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{instanceAId}}/functions/data

###############################################################################
# STEP 8: Advance instance B from processing
# complete-processing → review-state (v2 extra state)
###############################################################################

### Instance B - complete-processing (v2: expect review-state)
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{instanceBId}}/transitions/complete-processing?sync=true
Content-Type: application/json

{}

### Instance B - State check (expect review-state)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{instanceBId}}/functions/state

### Instance B - Data check (reviewExecuted=true)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{instanceBId}}/functions/data

###############################################################################
# STEP 9: Instance B review → completed
###############################################################################

### Instance B - approve-review (v2: completed-state)
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{instanceBId}}/transitions/approve-review?sync=true
Content-Type: application/json

{}

### Instance B - Final state (expect completed-state)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{instanceBId}}/functions/state

### Instance B - Final data
# EXPECTED: reviewExecuted=true, v2Completed=true; v1Completed must NOT be set
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{instanceBId}}/functions/data

###############################################################################
# VALIDATION SUMMARY
#
# Instance A (v1.0.0):
#   - State: completed-state
#   - Data: v1Completed=true, completedByVersion="1.0.0"
#   - reviewExecuted must be absent (no review-state on v1)
#
# Instance B (v2.0.0):
#   - State: completed-state
#   - Data: reviewExecuted=true, v2Completed=true, completedByVersion="2.0.0"
#   - v1Completed must NOT be set (followed v2 path)
#
# SUCCESS:
#   After publishing v2, instance A still completes on the v1 path and reaches
#   completed without passing through review-state.
###############################################################################
