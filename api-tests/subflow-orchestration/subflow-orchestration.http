@baseUrl = http://localhost:4201
@apiVersion = 1
@domain = core
@workflow = subflow-orchestration-parent

###############################################################################
# TEST 1: Happy path
# Start parent (autos to child-manual-state), proceed-to-subflow (launches
# grandchild), complete grandchild, cascade to parent-completed.
###############################################################################

### TEST 1 — Step 1: Start parent workflow (sync)
# @name createHappyPathInstance
POST {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/start?sync=true
Content-Type: application/json

{
  "key": "subflow-orch-happy-{{$timestamp}}",
  "tags": ["integration-test", "subflow-orchestration"],
  "attributes": {
    "testId": "orch-happy-path",
    "parentData": {
      "note": "from-parent-start"
    }
  }
}

@happyParentInstanceId = {{createHappyPathInstance.response.body.$.id}}

### TEST 1 — Step 2: State (should be child-manual-state after autos)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{happyParentInstanceId}}/functions/state

### TEST 1 — Step 3: Proceed to subflow (manual transition on child)
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{happyParentInstanceId}}/transitions/proceed-to-subflow?sync=true
Content-Type: application/json

{}

### TEST 1 — Step 4: State (deepest active should be grandchild-initial)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{happyParentInstanceId}}/functions/state

### TEST 1 — Step 5: Complete grandchild (routed via parent instance)
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{happyParentInstanceId}}/transitions/complete-grandchild?sync=true
Content-Type: application/json

{}

### TEST 1 — Step 6: State should reach parent-completed after cascade autos
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{happyParentInstanceId}}/functions/state

### TEST 1 — Step 7: Instance data flags
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{happyParentInstanceId}}/functions/data

###############################################################################
# TEST 2: Cancel cascade
# Start parent, proceed to subflow so grandchild is running, then cancel
# parent. Expect parent-cancelled and cancel cascade into child/grandchild.
###############################################################################

### TEST 2 — Step 1: Start parent (sync)
# @name createCancelCascadeInstance
POST {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/start?sync=true
Content-Type: application/json

{
  "key": "subflow-orch-cancel-cascade-{{$timestamp}}",
  "tags": ["integration-test", "subflow-orchestration", "cancel-cascade"],
  "attributes": {
    "testId": "orch-cancel-cascade"
  }
}

@cancelCascadeParentInstanceId = {{createCancelCascadeInstance.response.body.$.id}}

### TEST 2 — Step 2: Proceed to subflow
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{cancelCascadeParentInstanceId}}/transitions/proceed-to-subflow?sync=true
Content-Type: application/json

{}

### TEST 2 — Step 3: State should show grandchild-initial (nested)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{cancelCascadeParentInstanceId}}/functions/state

### TEST 2 — Step 4: Cancel parent while nested (cascade should terminate child/grandchild)
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{cancelCascadeParentInstanceId}}/transitions/cancel-parent?sync=true
Content-Type: application/json

{}

### TEST 2 — Step 5: Verify parent reached parent-cancelled
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{cancelCascadeParentInstanceId}}/functions/state

###############################################################################
# TEST 3: Shared transition in allowed state (availableIn)
# Start parent → child reaches child-manual-state. Fire shared-child-mark
# (availableIn includes child-manual-state). Verify childSharedMarkExecuted.
# Then proceed to subflow, complete grandchild, verify final state.
###############################################################################

### TEST 3 — Step 1: Start parent (sync)
# @name createSharedMarkInstance
POST {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/start?sync=true
Content-Type: application/json

{
  "key": "subflow-orch-shared-mark-{{$timestamp}}",
  "tags": ["integration-test", "subflow-orchestration", "shared-transition"],
  "attributes": {
    "testId": "orch-shared-mark",
    "parentData": {
      "beforeSharedMark": true
    }
  }
}

@sharedMarkParentInstanceId = {{createSharedMarkInstance.response.body.$.id}}

### TEST 3 — Step 2: State (should be child-manual-state)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{sharedMarkParentInstanceId}}/functions/state

### TEST 3 — Step 3: Trigger shared-child-mark (child is in child-manual-state → availableIn match)
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{sharedMarkParentInstanceId}}/transitions/shared-child-mark?sync=true
Content-Type: application/json

{}

### TEST 3 — Step 4: Data should include childSharedMarkExecuted=true (child data)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{sharedMarkParentInstanceId}}/functions/data

### TEST 3 — Step 5: State should still be child-manual-state (target: $self)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{sharedMarkParentInstanceId}}/functions/state

### TEST 3 — Step 6: Proceed to subflow
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{sharedMarkParentInstanceId}}/transitions/proceed-to-subflow?sync=true
Content-Type: application/json

{}

### TEST 3 — Step 7: Complete grandchild then verify final cascade
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{sharedMarkParentInstanceId}}/transitions/complete-grandchild?sync=true
Content-Type: application/json

{}

### TEST 3 — Step 8: Final state and data
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{sharedMarkParentInstanceId}}/functions/state

GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{sharedMarkParentInstanceId}}/functions/data

###############################################################################
# TEST 4: Effective state
# After start + proceed-to-subflow, /functions/state should expose
# effectiveState (deepest active subflow state, e.g. grandchild-initial).
###############################################################################

### TEST 4 — Step 1: Start parent (sync)
# @name createEffectiveStateInstance
POST {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/start?sync=true
Content-Type: application/json

{
  "key": "subflow-orch-effective-{{$timestamp}}",
  "tags": ["integration-test", "subflow-orchestration", "effective-state"],
  "attributes": {
    "testId": "orch-effective-state"
  }
}

@effectiveStateParentInstanceId = {{createEffectiveStateInstance.response.body.$.id}}

### TEST 4 — Step 2: Proceed to subflow
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{effectiveStateParentInstanceId}}/transitions/proceed-to-subflow?sync=true
Content-Type: application/json

{}

### TEST 4 — Step 3: State function — verify effectiveState shows grandchild-initial
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{effectiveStateParentInstanceId}}/functions/state

### TEST 4 — Step 4: Optional data snapshot while nested
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{effectiveStateParentInstanceId}}/functions/data

###############################################################################
# TEST 5: UpdateData transition from SubFlow
# Start parent, proceed to subflow (grandchild running), trigger updateData
# (update-parent-data) from child. This updates parent instance data with
# childUpdatedParent=true via UpdateParentDataMapping.csx.
###############################################################################

### TEST 5 — Step 1: Start parent (sync)
# @name createUpdateDataInstance
POST {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/start?sync=true
Content-Type: application/json

{
  "key": "subflow-orch-updatedata-{{$timestamp}}",
  "tags": ["integration-test", "subflow-orchestration", "update-data"],
  "attributes": {
    "testId": "orch-update-data"
  }
}

@updateDataParentInstanceId = {{createUpdateDataInstance.response.body.$.id}}

### TEST 5 — Step 2: Proceed to subflow
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{updateDataParentInstanceId}}/transitions/proceed-to-subflow?sync=true
Content-Type: application/json

{}

### TEST 5 — Step 3: Verify nested state (grandchild-initial)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{updateDataParentInstanceId}}/functions/state

### TEST 5 — Step 4: Trigger updateData transition from child
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{updateDataParentInstanceId}}/transitions/update-parent-data?sync=true
Content-Type: application/json

{
  "attributes": {
    "updateMessage": "from-child-updatedata"
  }
}

### TEST 5 — Step 5: Verify parent data now includes childUpdatedParent=true
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{updateDataParentInstanceId}}/functions/data

### TEST 5 — Step 6: Complete grandchild to finish the flow
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{updateDataParentInstanceId}}/transitions/complete-grandchild?sync=true
Content-Type: application/json

{}

### TEST 5 — Step 7: Verify final state
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{updateDataParentInstanceId}}/functions/state

###############################################################################
# TEST 6: Shared transition in DISALLOWED state (NOT in availableIn)
# Start parent → proceed to subflow (child reaches child-subflow-state,
# grandchild is running). Try shared-child-mark — child is in
# child-subflow-state which is NOT in availableIn. Transition should be
# rejected (state should not change). Then complete grandchild normally.
###############################################################################

### TEST 6 — Step 1: Start parent (sync)
# @name createSharedDisallowedInstance
POST {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/start?sync=true
Content-Type: application/json

{
  "key": "subflow-orch-shared-disallowed-{{$timestamp}}",
  "tags": ["integration-test", "subflow-orchestration", "shared-transition-disallowed"],
  "attributes": {
    "testId": "orch-shared-disallowed"
  }
}

@sharedDisallowedParentInstanceId = {{createSharedDisallowedInstance.response.body.$.id}}

### TEST 6 — Step 2: Proceed to subflow (child → child-subflow-state, grandchild starts)
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{sharedDisallowedParentInstanceId}}/transitions/proceed-to-subflow?sync=true
Content-Type: application/json

{}

### TEST 6 — Step 3: State should show grandchild-initial (nested)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{sharedDisallowedParentInstanceId}}/functions/state

### TEST 6 — Step 4: Try shared-child-mark (child is in child-subflow-state — NOT in availableIn)
# Expected: transition rejected or not found; state should NOT change
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{sharedDisallowedParentInstanceId}}/transitions/shared-child-mark?sync=true
Content-Type: application/json

{}

### TEST 6 — Step 5: Verify state is still grandchild-initial (unchanged — shared transition rejected)
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{sharedDisallowedParentInstanceId}}/functions/state

### TEST 6 — Step 6: Data should NOT contain childSharedMarkExecuted
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{sharedDisallowedParentInstanceId}}/functions/data

### TEST 6 — Step 7: Complete grandchild normally
PATCH {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{sharedDisallowedParentInstanceId}}/transitions/complete-grandchild?sync=true
Content-Type: application/json

{}

### TEST 6 — Step 8: Verify final state parent-completed
GET {{baseUrl}}/api/v{{apiVersion}}/{{domain}}/workflows/{{workflow}}/instances/{{sharedDisallowedParentInstanceId}}/functions/state
