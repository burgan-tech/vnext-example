{
  "key": "collateral-detail",
  "version": "1.0.0",
  "domain": "core",
  "flow": "sys-schemas",
  "flowVersion": "1.0.0",
  "tags": ["collateral", "subflow", "master"],
  "attributes": {
    "type": "workflow",
    "labels": [
      { "label": "Teminat Detayı", "language": "tr-TR" },
      { "label": "Collateral Detail", "language": "en-US" }
