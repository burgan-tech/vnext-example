          "type": "string",
          "enum": ["ipotek", "rehin", "kefalet", "nakit_blokaj"],
          "x-labels": { "tr": "Teminat Tipi", "en": "Collateral Type" },
          "x-enum": {
            "ipotek": { "tr": "İpotek", "en": "Mortgage Lien" },
            "rehin": { "tr": "Rehin", "en": "Pledge" },
            "kefalet": { "tr": "Kefalet", "en": "Surety" },
