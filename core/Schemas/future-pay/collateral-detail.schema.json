        },
        "collateralValue": { "type": "number", "x-labels": { "tr": "Teminat Değeri", "en": "Collateral Value" } },
        "establishmentStatus": { "type": "string", "x-labels": { "tr": "Tesis Durumu", "en": "Establishment Status" } },
        "titleDeedRef": { "type": "string", "x-labels": { "tr": "Tapu Referansı", "en": "Title Deed Reference" } }
