{
  "key": "schema-validation-start",
  "version": "1.0.0",
  "domain": "core",
  "flow": "sys-schemas",
  "flowVersion": "1.0.0",
  "tags": [
    "integration-test",
    "schema-validation",
    "schema",
    "start-schema"
  ],
  "attributes": {
    "type": "workflow",
    "labels": [
      {
        "language": "en-US",
        "label": "Schema Validation Start Transition Schema"
      }
    ],
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://core.burgan.com/schemas/schema-validation-start",
      "title": "Start Transition Payload Schema",
      "type": "object",
      "required": [
        "orderId",
        "customerName",
        "amount",
        "currency"
      ],
      "properties": {
        "orderId": {
          "type": "string",
          "minLength": 1
        },
        "customerName": {
          "type": "string",
          "minLength": 1
        },
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "enum": ["TRY", "USD", "EUR"]
        }
      },
      "additionalProperties": true
    }
  }
}
