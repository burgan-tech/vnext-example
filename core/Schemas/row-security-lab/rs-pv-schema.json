{
  "key": "rs-pv-schema",
  "version": "1.0.0",
  "domain": "core",
  "flow": "sys-schemas",
  "flowVersion": "1.0.0",
  "tags": [
    "integration-test",
    "row-security-lab",
    "master"
  ],
  "attributes": {
    "type": "master",
    "labels": [
      {
        "language": "en-US",
        "label": "Row Security Lab publish-validation master (protected paths)"
      }
    ],
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:vnext:res:schema:core:rs-pv-schema",
      "title": "Row Security Lab publish-validation master (protected paths)",
      "type": "object",
      "required": [
        "testId",
        "kind"
      ],
      "properties": {
        "testId": {
          "type": "string",
          "x-filterOperators": [
            "eq"
          ]
        },
        "kind": {
          "type": "string",
          "x-filterOperators": [
            "eq",
            "neq"
          ]
        },
        "branchCode": {
          "type": "string",
          "x-filterOperators": [
            "eq",
            "neq",
            "in",
            "nin"
          ]
        },
        "region": {
          "type": "string",
          "x-indexed": true,
          "x-filterOperators": [
            "eq",
            "in"
          ]
        },
        "protected": {
          "type": "string",
          "x-roles": [
            {
              "role": "rs-protected-reader",
              "grant": "allow"
            }
          ]
        },
        "secret": {
          "type": "object",
          "properties": {
            "pin": {
              "type": "string",
              "x-encryption": {
                "type": "encrypt"
              }
            },
            "label": {
              "type": "string"
            }
          }
        },
        "tckn": {
          "type": "string",
          "x-encryption": {
            "type": "hash",
            "params": {
              "algorithm": "sha256"
            }
          }
        },
        "iban": {
          "type": "string",
          "x-masking": {
            "operator": "mask",
            "params": {
              "keepLast": 4
            }
          }
        }
      }
    }
  }
}
