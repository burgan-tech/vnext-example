{
  "key": "schema-data-master",
  "version": "1.0.0",
  "domain": "core",
  "flow": "sys-schemas",
  "flowVersion": "1.0.0",
  "tags": [
    "integration-test",
    "schema-data",
    "master-schema",
    "field-roles"
  ],
  "attributes": {
    "type": "workflow",
    "labels": [
      {
        "language": "en-US",
        "label": "Schema Data Test Master Schema"
      }
    ],
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://core.burgan.com/schemas/schema-data-master",
      "title": "Schema Data Test Master Schema",
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string",
          "minLength": 1
        },
        "customerName": {
          "type": "string",
          "minLength": 1
        },
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "enum": [
            "TRY",
            "USD",
            "EUR"
          ]
        },
        "status": {
          "type": "string"
        },
        "internalNote": {
          "type": "string",
          "roles": [
            {
              "role": "admin",
              "grant": "allow"
            },
            {
              "role": "customer",
              "grant": "deny"
            }
          ]
        },
        "auditLog": {
          "type": "string",
          "roles": [
            {
              "role": "auditor",
              "grant": "allow"
            }
          ]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "orderId",
        "customerName",
        "amount",
        "currency"
      ],
      "additionalProperties": true
    }
  }
}
