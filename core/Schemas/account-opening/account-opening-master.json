{
  "key": "account-opening-master",
  "version": "1.0.0",
  "domain": "core",
  "flow": "sys-schemas",
  "flowVersion": "1.0.0",
  "tags": [
    "banking",
    "account-opening",
    "master-schema",
    "role-visibility",
    "demand-deposit"
  ],
  "attributes": {
    "type": "workflow",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:vnext:res:schema:core:account-opening-master",
      "title": "Account Opening Workflow Master Schema",
      "description": "Master schema for account-opening instance data with field-level visibility (roles). Used by function response filtering per request header role.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "initial": {
          "type": "object",
          "description": "Initial request/session data",
          "additionalProperties": true,
          "properties": {
            "session": {
              "type": "string",
              "description": "Session identifier",
              "x-labels": {
                "en": "Session",
                "tr": "Oturum"
              }
            },
            "requestId": {
              "type": "string",
              "description": "Request correlation ID",
              "x-labels": {
                "en": "Request ID",
                "tr": "Talep Numarası"
              },
              "x-roles": [
                { "role": "morph-idm.maker", "grant": "allow" },
                { "role": "morph-idm.approver", "grant": "allow" },
                { "role": "morph-idm.manager", "grant": "allow" }
              ]
            }
          }
        },
        "currency": {
          "type": "string",
          "description": "Account currency",
          "x-labels": {
            "en": "Currency",
            "tr": "Para Birimi"
          }
        },
        "confirmed": {
          "type": "boolean",
          "description": "User confirmation flag",
          "x-labels": {
            "en": "Confirmation",
            "tr": "Onay"
          }
        },
        "branchCode": {
          "type": "string",
          "description": "Branch code",
          "x-labels": {
            "en": "Branch Code",
            "tr": "Şube Kodu"
          },
          "x-roles": [
                { "role": "$PreviousUser", "grant": "allow" }
              ]
        },
        "branchDetail": {
          "type": "object",
          "description": "Read-only branch enrichment looked up from branchCode (display only). Accessed via $lookup.branchDetail.* in views; activated by the view's lookups: [\"branchDetail\"] array.",
          "additionalProperties": true,
          "x-lookup": {
            "source": "urn:vnext:fn:core:get-branch-detail",
            "resultField": "$.data",
            "filter": [
              { "param": "code", "value": "$instance.branchCode", "required": true }
            ]
          }
        },
        "accountName": {
          "type": "string",
          "description": "Account name/alias",
          "x-labels": {
            "en": "Account Name",
            "tr": "Hesap Adı"
          },
          "x-roles": [
                { "role": "$PreviousUser", "grant": "deny" }
              ]
        },
        "accountType": {
          "type": "string",
          "description": "Account type (e.g. demand-deposit). Read-only in the master/instance schema; user input is captured by the account-type-selection transition schema, which carries the x-lov definition.",
          "x-labels": {
            "en": "Account Type",
            "tr": "Hesap Türü"
          }
        },
        "userSession": {
          "type": "object",
          "description": "User/session context; restricted to approver and above",
          "additionalProperties": true,
          "properties": {
            "userId": {
              "type": "string",
              "x-roles": [
                { "role": "morph-idm.approver", "grant": "allow" },
                { "role": "morph-idm.manager", "grant": "allow" }
              ]
            },
            "deviceId": {
              "type": "string",
              "x-roles": [
                { "role": "morph-idm.approver", "grant": "allow" },
                { "role": "morph-idm.manager", "grant": "allow" }
              ]
            },
            "ipAddress": {
              "type": "string",
              "x-roles": [
                { "role": "morph-idm.approver", "grant": "allow" },
                { "role": "morph-idm.manager", "grant": "allow" }
              ]
            },
            "userAgent": {
              "type": "string",
              "x-roles": [
                { "role": "morph-idm.approver", "grant": "allow" },
                { "role": "morph-idm.manager", "grant": "allow" }
              ]
            }
          }
        },
        "notifications": {
          "type": "object",
          "description": "Notification preferences",
          "additionalProperties": true,
          "x-labels": {
            "en": "Notification Preferences",
            "tr": "Bildirim Tercihleri"
          },
          "properties": {
            "smsNotifications": {
              "type": "boolean",
              "x-labels": {
                "en": "SMS Notifications",
                "tr": "SMS Bildirimleri"
              }
            },
            "pushNotifications": {
              "type": "boolean",
              "x-labels": {
                "en": "Push Notifications",
                "tr": "Anlık Bildirimler"
              }
            },
            "emailNotifications": {
              "type": "boolean",
              "x-labels": {
                "en": "Email Notifications",
                "tr": "E-posta Bildirimleri"
              }
            }
          }
        },
        "termsAccepted": {
          "type": "boolean",
          "x-labels": {
            "en": "Terms Accepted",
            "tr": "Koşullar Kabul Edildi"
          }
        },
        "accountPurpose": {
          "type": "string",
          "x-labels": {
            "en": "Account Purpose",
            "tr": "Hesap Amacı"
          }
        },
        "termMonths": {
          "type": "integer",
          "description": "Time deposit term in months",
          "x-labels": {
            "en": "Term (Months)",
            "tr": "Vade (Ay)"
          }
        },
        "maturityInstruction": {
          "type": "string",
          "description": "What to do at time-deposit maturity",
          "x-labels": {
            "en": "Maturity Instruction",
            "tr": "Vade Sonu Talimatı"
          }
        },
        "minimumDeposit": {
          "type": "number",
          "description": "Minimum required deposit for time deposit",
          "x-labels": {
            "en": "Minimum Deposit",
            "tr": "Minimum Yatırım"
          }
        },
        "riskProfile": {
          "type": "string",
          "description": "Investor risk tolerance",
          "x-labels": {
            "en": "Risk Profile",
            "tr": "Risk Profili"
          }
        },
        "investmentExperience": {
          "type": "string",
          "description": "Prior investment experience",
          "x-labels": {
            "en": "Investment Experience",
            "tr": "Yatırım Deneyimi"
          }
        },
        "investmentObjective": {
          "type": "string",
          "description": "Investment objective category",
          "x-labels": {
            "en": "Investment Objective",
            "tr": "Yatırım Hedefi"
          }
        },
        "savingsGoalAmount": {
          "type": "number",
          "description": "Target savings amount",
          "x-labels": {
            "en": "Savings Goal Amount",
            "tr": "Birikim Hedef Tutarı"
          }
        },
        "targetDate": {
          "type": "string",
          "format": "date",
          "description": "Target date for the savings goal",
          "x-labels": {
            "en": "Target Date",
            "tr": "Hedef Tarih"
          }
        },
        "autoTransferFromAccount": {
          "type": "string",
          "description": "IBAN to auto-transfer from for savings",
          "x-labels": {
            "en": "Auto-Transfer Source",
            "tr": "Otomatik Aktarım Kaynağı"
          }
        },
        "initialDeposit": {
          "type": "number",
          "description": "Initial deposit amount",
          "x-labels": {
            "en": "Initial Deposit",
            "tr": "Başlangıç Yatırımı"
          }
        },
        "accountCreation": {
          "type": "object",
          "description": "Full account creation result; internal IDs and limits restricted",
          "additionalProperties": true,
          "x-labels": {
            "en": "Account Creation Result",
            "tr": "Hesap Oluşturma Sonucu"
          },
          "properties": {
            "iban": {
              "type": "string",
              "x-labels": {
                "en": "IBAN",
                "tr": "IBAN"
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "maximumBalance": { "type": "number" },
                "minimumBalance": { "type": "number" },
                "dailyTransactionLimit": { "type": "number" },
                "monthlyTransactionLimit": { "type": "number" }
              },
              "x-roles": [
                { "role": "morph-idm.approver", "grant": "allow" },
                { "role": "morph-idm.manager", "grant": "allow" }
              ]
            },
            "status": {
              "type": "string",
              "x-labels": {
                "en": "Status",
                "tr": "Durum"
              }
            },
            "success": { "type": "boolean" },
            "currency": {
              "type": "string",
              "x-labels": {
                "en": "Currency",
                "tr": "Para Birimi"
              }
            },
            "isActive": { "type": "boolean" },
            "services": {
              "type": "array",
              "items": { "type": "string" }
            },
            "accountId": {
              "type": "string",
              "x-roles": [
                { "role": "morph-idm.maker", "grant": "allow" },
                { "role": "morph-idm.approver", "grant": "allow" },
                { "role": "morph-idm.manager", "grant": "allow" }
              ]
            },
            "createdAt": { "type": "string", "format": "date-time" },
            "branchCode": {
              "type": "string",
              "x-labels": {
                "en": "Branch Code",
                "tr": "Şube Kodu"
              }
            },
            "accountType": {
              "type": "string",
              "x-labels": {
                "en": "Account Type",
                "tr": "Hesap Türü"
              }
            },
            "accountNumber": {
              "type": "string",
              "x-labels": {
                "en": "Account Number",
                "tr": "Hesap Numarası"
              }
            },
            "coreBankingId": {
              "type": "string",
              "x-roles": [
                { "role": "morph-idm.approver", "grant": "allow" },
                { "role": "morph-idm.manager", "grant": "allow" }
              ]
            },
            "currentBalance": { "type": "number" },
            "availableBalance": { "type": "number" },
            "creationReference": {
              "type": "string",
              "x-roles": [
                { "role": "morph-idm.approver", "grant": "allow" },
                { "role": "morph-idm.manager", "grant": "allow" }
              ]
            },
            "debitCardRequested": { "type": "boolean" },
            "mobileBankingEnabled": { "type": "boolean" },
            "onlineBankingEnabled": { "type": "boolean" }
          }
        },
        "policyValidation": {
          "type": "object",
          "description": "Policy/compliance validation result; internal details restricted",
          "additionalProperties": true,
          "x-labels": {
            "en": "Policy Validation",
            "tr": "Politika Doğrulama"
          },
          "properties": {
            "passed": { "type": "boolean" },
            "approvedBy": {
              "type": "string",
              "x-roles": [
                { "role": "morph-idm.approver", "grant": "allow" },
                { "role": "morph-idm.manager", "grant": "allow" }
              ]
            },
            "validatedAt": { "type": "string", "format": "date-time" },
            "validationId": {
              "type": "string",
              "x-roles": [
                { "role": "morph-idm.approver", "grant": "allow" },
                { "role": "morph-idm.manager", "grant": "allow" }
              ]
            },
            "accountLimits": {
              "type": "object",
              "additionalProperties": true,
              "x-roles": [
                { "role": "morph-idm.approver", "grant": "allow" },
                { "role": "morph-idm.manager", "grant": "allow" }
              ]
            },
            "approvalLevel": {
              "type": "string",
              "x-roles": [
                { "role": "morph-idm.approver", "grant": "allow" },
                { "role": "morph-idm.manager", "grant": "allow" }
              ]
            },
            "policyVersion": { "type": "string" },
            "validationScore": {
              "type": "number",
              "x-roles": [
                { "role": "morph-idm.approver", "grant": "allow" },
                { "role": "morph-idm.manager", "grant": "allow" }
              ]
            },
            "complianceChecks": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "amlCompliant": { "type": "boolean" },
                "kycCompliant": { "type": "boolean" },
                "riskAssessment": { "type": "string" },
                "sanctionsCheck": { "type": "boolean" }
              },
              "x-roles": [
                { "role": "morph-idm.approver", "grant": "allow" },
                { "role": "morph-idm.manager", "grant": "allow" }
              ]
            },
            "additionalRequirements": {
              "type": "array",
              "items": {}
            }
          }
        },
        "privacyPolicyAccepted": {
          "type": "boolean",
          "x-labels": {
            "en": "Privacy Policy Accepted",
            "tr": "Gizlilik Politikası Kabul Edildi"
          }
        }
      }
    }
  }
}
