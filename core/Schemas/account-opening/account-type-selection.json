{
  "key": "account-type-selection",
  "version": "1.0.0",
  "domain": "core",
  "flow": "sys-schemas",
  "flowVersion": "1.0.0",
  "tags": [
    "banking",
    "account-type",
    "selection",
    "input-schema"
  ],
  "attributes": {
    "type": "workflow",
    "schema": {
      "$id": "urn:amorphie:res:schema:core:account-type-selection",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Account Type Selection Schema",
      "description": "Schema for account type selection input",
      "type": "object",
      "required": [
        "accountType"
      ],
      "properties": {
        "accountType": {
          "type": "string",
          "title": "Account Type",
          "description": "Type of account to be opened. Enum + x-enum carry the validation contract and localised labels; the account-type-selection-view renders a static navigation Card grid (each Card dispatches its own select-{type} transition).",
          "x-labels": {
            "en": "Account Type",
            "tr": "Hesap Türü"
          },
          "x-errorMessages": {
            "required": {
              "en": "Please select an account type",
              "tr": "Lütfen bir hesap türü seçin"
            },
            "enum": {
              "en": "Please select a valid account type",
              "tr": "Lütfen geçerli bir hesap türü seçin"
            }
          },
          "enum": [
            "demand-deposit",
            "time-deposit",
            "investment-account",
            "savings-account"
          ],
          "x-enum": {
            "demand-deposit": {
              "en": "Demand Deposit Account",
              "tr": "Vadesiz Mevduat Hesabı"
            },
            "time-deposit": {
              "en": "Time Deposit Account",
              "tr": "Vadeli Mevduat Hesabı"
            },
            "investment-account": {
              "en": "Investment Account",
              "tr": "Yatırım Hesabı"
            },
            "savings-account": {
              "en": "Savings Account",
              "tr": "Birikim Hesabı"
            }
          }
        }
      },
      "additionalProperties": true
    }
  }
}
