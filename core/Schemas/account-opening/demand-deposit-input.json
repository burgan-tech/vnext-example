{
  "key": "demand-deposit-input",
  "version": "1.0.0",
  "domain": "core",
  "flow": "sys-schemas",
  "flowVersion": "1.0.0",
  "tags": [
    "banking",
    "account-details",
    "input-schema",
    "demand-deposit"
  ],
  "attributes": {
    "type": "workflow",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:amorphie:res:schema:core:demand-deposit-input",
      "title": "Demand Deposit Input Schema",
      "description": "Input schema for demand deposit account details during account opening",
      "type": "object",
      "required": [
        "accountName",
        "currency",
        "branchCode"
      ],
      "properties": {
        "accountName": {
          "type": "string",
          "title": "Account Name",
          "description": "Name/alias for the account. Uniqueness is checked asynchronously via the host's onValidationRequest delegate (rule: unique-account-name).",
          "minLength": 1,
          "maxLength": 50,
          "pattern": "^[a-zA-Z0-9\\s\\-_]+$",
          "x-labels": {
            "en": "Account Name",
            "tr": "Hesap Adı"
          },
          "x-errorMessages": {
            "required": {
              "en": "Please enter an account name",
              "tr": "Lütfen hesap adı girin"
            },
            "minLength": {
              "en": "Account name must be at least 1 character",
              "tr": "Hesap adı en az 1 karakter olmalıdır"
            },
            "maxLength": {
              "en": "Account name must be at most 50 characters",
              "tr": "Hesap adı en fazla 50 karakter olmalıdır"
            },
            "pattern": {
              "en": "Please enter a valid account name using letters, numbers, spaces, hyphens, or underscores",
              "tr": "Lütfen harf, rakam, boşluk, tire veya alt çizgi içeren geçerli bir hesap adı girin"
            }
          },
          "x-validation": {
            "rule": "unique-account-name",
            "errorMessages": {
              "en": "An account with this name already exists",
              "tr": "Bu isimde bir hesap zaten var"
            }
          }
        },
        "currency": {
          "type": "string",
          "title": "Currency",
          "description": "Account currency",
          "x-labels": {
            "en": "Currency",
            "tr": "Para Birimi"
          },
          "x-errorMessages": {
            "required": {
              "en": "Please select a currency",
              "tr": "Lütfen bir para birimi seçin"
            },
            "enum": {
              "en": "Please select a valid currency",
              "tr": "Lütfen geçerli bir para birimi seçin"
            }
          },
          "enum": [
            "TRY",
            "USD",
            "EUR",
            "GBP",
            "SLV"
          ],
          "x-enum": {
            "TRY": {
              "en": "Turkish Lira",
              "tr": "Türk Lirası"
            },
            "USD": {
              "en": "US Dollar",
              "tr": "ABD Doları"
            },
            "EUR": {
              "en": "Euro",
              "tr": "Euro"
            },
            "GBP": {
              "en": "British Pound",
              "tr": "İngiliz Sterlini"
            },
            "SLV": {
              "en": "Solomon Islands Dollar",
              "tr": "Solomon Adaları Doları"
            }
          }
        },
        "branchCode": {
          "type": "string",
          "title": "Branch Code",
          "description": "Branch where the account will be opened. Options come from the get-branches LOV, filtered by the selected currency (cascade).",
          "pattern": "^[0-9]{4}$",
          "x-labels": {
            "en": "Branch Code",
            "tr": "Şube Kodu"
          },
          "x-errorMessages": {
            "required": {
              "en": "Please select a branch",
              "tr": "Lütfen şube seçin"
            },
            "pattern": {
              "en": "Please pick a valid 4-digit branch code",
              "tr": "Lütfen 4 haneli geçerli bir şube kodu seçin"
            }
          },
          "x-lov": {
            "source": "urn:amorphie:func:core:get-branches",
            "valueField": "$.data[*].code",
            "displayField": "$.data[*].name",
            "filter": [
              { "param": "currency", "value": "$form.currency", "required": true }
            ]
          }
        },
        "branchDetail": {
          "type": "object",
          "title": "Branch Detail",
          "description": "Read-only branch enrichment looked up from the selected branchCode. Display only — not a form input. Accessed via $lookup.branchDetail.* in the view (activated by lookups: [\"branchDetail\"]).",
          "additionalProperties": true,
          "x-lookup": {
            "source": "urn:amorphie:func:core:get-branch-detail",
            "resultField": "$.data",
            "filter": [
              { "param": "code", "value": "$form.branchCode", "required": true }
            ]
          }
        },
        "initialDeposit": {
          "type": "number",
          "title": "Initial Deposit",
          "description": "Initial deposit amount (optional)",
          "minimum": 0,
          "maximum": 1000000,
          "x-labels": {
            "en": "Initial Deposit",
            "tr": "Başlangıç Yatırımı"
          }
        },
        "accountPurpose": {
          "type": "string",
          "title": "Account Purpose",
          "description": "Purpose of the account",
          "x-labels": {
            "en": "Account Purpose",
            "tr": "Hesap Amacı"
          },
          "enum": [
            "personal-banking",
            "salary-account",
            "savings",
            "business-expenses"
          ],
          "x-enum": {
            "personal-banking": {
              "en": "Personal Banking",
              "tr": "Bireysel Bankacılık"
            },
            "salary-account": {
              "en": "Salary Account",
              "tr": "Maaş Hesabı"
            },
            "savings": {
              "en": "Savings",
              "tr": "Birikim"
            },
            "business-expenses": {
              "en": "Business Expenses",
              "tr": "İş Harcamaları"
            }
          }
        },
        "notifications": {
          "type": "object",
          "title": "Notification Preferences",
          "description": "Notification settings for the account",
          "x-labels": {
            "en": "Notification Preferences",
            "tr": "Bildirim Tercihleri"
          },
          "properties": {
            "smsNotifications": {
              "type": "boolean",
              "title": "SMS Notifications",
              "description": "Enable SMS notifications",
              "default": true,
              "x-labels": {
                "en": "SMS Notifications",
                "tr": "SMS Bildirimleri"
              }
            },
            "emailNotifications": {
              "type": "boolean",
              "title": "Email Notifications",
              "description": "Enable email notifications",
              "default": true,
              "x-labels": {
                "en": "Email Notifications",
                "tr": "E-posta Bildirimleri"
              }
            },
            "pushNotifications": {
              "type": "boolean",
              "title": "Push Notifications",
              "description": "Enable push notifications",
              "default": true,
              "x-labels": {
                "en": "Push Notifications",
                "tr": "Anlık Bildirimler"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
