{
  "key": "triage-working",
  "version": "1.0.0",
  "domain": "core",
  "flow": "sys-views",
  "flowVersion": "1.0.0",
  "tags": [
    "example",
    "ai-agent",
    "triage"
  ],
  "attributes": {
    "type": 1,
    "display": {
      "sdi": "full-page",
      "mdi": "full-page"
    },
    "renderer": "pseudo-ui",
    "labels": [
      {
        "language": "tr-TR",
        "label": "Sınıflandırılıyor"
      },
      {
        "language": "en-US",
        "label": "Classifying"
      }
    ],
    "content": {
      "$schema": "https://amorphie.io/meta/view-vocabulary/1.0",
      "dataSchema": "urn:vnext:res:schema:core:triage-master",
      "view": {
        "type": "ScrollView",
        "children": [
          {
            "type": "Column",
            "gap": "md",
            "children": [
              {
                "type": "Row",
                "gap": "sm",
                "crossAxisAlignment": "center",
                "children": [
                  {
                    "type": "Icon",
                    "name": "hourglass_top"
                  },
                  {
                    "type": "Text",
                    "content": {
                      "tr": "Mesajınız değerlendiriliyor",
                      "en": "Classifying your message"
                    },
                    "variant": "headlineMedium"
                  }
                ]
              },
              {
                "type": "LoadingIndicator"
              },
              {
                "type": "Card",
                "variant": "outlined",
                "children": [
                  {
                    "type": "Column",
                    "gap": "sm",
                    "children": [
                      {
                        "type": "ListTile",
                        "title": {
                          "tr": "Mesaj",
                          "en": "Message"
                        },
                        "subtitle": "$instance.message"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  }
}
