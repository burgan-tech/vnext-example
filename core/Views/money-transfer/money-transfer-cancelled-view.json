                "variant": "bodyMedium"
              }
            ]
          }
        ]
      }
    },
    "labels": [
      { "label": "Para Transferi İptal Edildi", "language": "tr-TR" },
      { "label": "Money Transfer Cancelled", "language": "en-US" }
    ]
  }
