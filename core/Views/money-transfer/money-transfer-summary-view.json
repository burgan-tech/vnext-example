{
  "key": "money-transfer-summary-view",
  "version": "1.0.0",
  "domain": "core",
  "flow": "sys-views",
  "flowVersion": "1.0.0",
  "tags": ["money-transfer", "summary", "display", "pseudo-ui"],
  "attributes": {
    "type": 1,
    "display": "full-page",
    "renderer": "pseudo-ui",
    "content": {
      "$schema": "https://amorphie.io/meta/view-vocabulary/1.0",
      "dataSchema": "urn:vnext:res:schema:core:money-transfer-master",
      "view": {
        "type": "ScrollView",
        "children": [
          {
            "type": "Column",
            "gap": "md",
            "children": [
              {
                "type": "Row",
                "gap": "sm",
                "children": [
                  { "type": "Icon", "name": "fact_check" },
                  {
                    "type": "Text",
                    "content": { "tr": "Gözden Geçir ve Onayla", "en": "Review and Confirm" },
                    "variant": "headlineMedium"
                  }
                ]
              },
              {
                "type": "Card",
                "variant": "outlined",
                "children": [
                  {
                    "type": "Column",
                    "gap": "sm",
                    "children": [
                      {
                        "type": "ListTile",
                        "title": "$schema.sourceAccountId.label",
                        "subtitle": "$instance.sourceAccountId"
                      },
                      {
                        "type": "ListTile",
                        "title": "$schema.targetIban.label",
                        "subtitle": "$instance.targetIban"
                      },
                      {
                        "type": "ListTile",
                        "title": "$schema.amount.label",
                        "subtitle": "$instance.amount"
                      },
                      {
                        "type": "ListTile",
                        "title": "$schema.currency.label",
                        "subtitle": "$instance.currency"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "Row",
                "gap": "sm",
                "children": [
                  {
                    "type": "Button",
                    "label": { "tr": "Onayla", "en": "Confirm" },
                    "action": "submit",
                    "command": "urn:vnext:flow:transition:core:money-transfer:confirm"
                  },
                  {
                    "type": "Button",
                    "label": { "tr": "İptal", "en": "Cancel" },
                    "action": "cancel",
                    "command": "urn:vnext:flow:transition:core:money-transfer:cancel-transfer"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    "labels": [
      { "label": "Para Transferi Özeti", "language": "tr-TR" },
      { "label": "Money Transfer Summary", "language": "en-US" }
    ]
  }
}
