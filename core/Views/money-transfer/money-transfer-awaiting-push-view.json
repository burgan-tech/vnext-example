{
  "key": "money-transfer-awaiting-push-view",
  "version": "1.0.0",
  "domain": "core",
  "flow": "sys-views",
  "flowVersion": "1.0.0",
  "tags": ["money-transfer", "awaiting-push", "display", "pseudo-ui"],
  "attributes": {
    "type": 1,
    "display": "full-page",
    "renderer": "pseudo-ui",
    "content": {
      "$schema": "https://amorphie.io/meta/view-vocabulary/1.0",
      "dataSchema": "urn:vnext:res:schema:core:money-transfer-master",
      "view": {
        "type": "ScrollView",
        "children": [
          {
            "type": "Column",
            "gap": "md",
            "children": [
              {
                "type": "Row",
                "gap": "sm",
                "children": [
                  { "type": "Icon", "name": "smartphone" },
                  {
                    "type": "Text",
                    "content": { "tr": "Cihazınızdan Onaylayın", "en": "Approve on Your Device" },
                    "variant": "headlineMedium"
                  }
                ]
              },
              {
                "type": "Text",
                "content": {
                  "tr": "İlk kez bu IBAN'a transfer yapıyorsunuz. Güvenliğiniz için mobil cihazınıza gönderilen bildirimi onaylayın.",
                  "en": "This is your first transfer to this IBAN. For your security, approve the notification sent to your mobile device."
                },
                "variant": "bodyMedium"
              },
              {
                "type": "Card",
                "variant": "outlined",
                "children": [
                  {
                    "type": "Column",
                    "gap": "sm",
                    "children": [
                      {
                        "type": "ListTile",
                        "title": "$schema.targetIban.label",
                        "subtitle": "$instance.targetIban"
                      },
                      {
                        "type": "ListTile",
                        "title": "$schema.amount.label",
                        "subtitle": "$instance.amount"
                      },
                      {
                        "type": "ListTile",
                        "title": "$schema.currency.label",
                        "subtitle": "$instance.currency"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "Row",
                "gap": "sm",
                "children": [
                  {
                    "type": "Button",
                    "label": { "tr": "Onayladım", "en": "I Approved" },
                    "action": "submit",
                    "command": "urn:vnext:flow:transition:core:money-transfer:approve-push"
                  },
                  {
                    "type": "Button",
                    "label": { "tr": "İptal", "en": "Cancel" },
                    "action": "cancel",
                    "command": "urn:vnext:flow:transition:core:money-transfer:cancel-transfer"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    "labels": [
      { "label": "Push Onayı Bekleniyor", "language": "tr-TR" },
      { "label": "Awaiting Push Approval", "language": "en-US" }
    ]
  }
}
