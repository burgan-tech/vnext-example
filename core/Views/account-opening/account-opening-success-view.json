{
  "key": "account-opening-success-view",
  "version": "1.0.0",
  "domain": "core",
  "flow": "sys-views",
  "flowVersion": "1.0.0",
  "tags": [
    "banking",
    "account-opening",
    "success",
    "ui-view"
  ],
  "attributes": {
    "type": 1,
    "labels": [
      { "language": "en-US", "label": "Account Opening Successful" }
    ],
    "display": "bottom-sheet",
    "renderer": "pseudo-ui",
    "content": {
      "$schema": "https://amorphie.io/meta/view-vocabulary/1.0",
      "dataSchema": "urn:amorphie:res:schema:core:account-opening-master",
      "view": {
        "type": "ScrollView",
        "children": [
          {
            "type": "Column",
            "gap": "md",
            "children": [
              {
                "type": "Text",
                "content": { "en": "Step 4 of 4 — Done", "tr": "Adım 4 / 4 — Tamamlandı" },
                "variant": "labelLarge"
              },
              {
                "type": "Center",
                "children": [
                  {
                    "type": "Column",
                    "gap": "sm",
                    "crossAxisAlignment": "center",
                    "children": [
                      { "type": "Icon", "name": "check_circle", "size": "lg" },
                      {
                        "type": "Text",
                        "content": { "en": "Account Created", "tr": "Hesap Oluşturuldu" },
                        "variant": "headlineMedium"
                      },
                      {
                        "type": "Text",
                        "content": { "en": "Your new account is ready to use.", "tr": "Yeni hesabınız kullanıma hazır." },
                        "variant": "bodyMedium"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "Card",
                "variant": "filled",
                "children": [
                  {
                    "type": "Column",
                    "gap": "xs",
                    "children": [
                      { "type": "Text", "content": { "en": "Account Details", "tr": "Hesap Detayları" }, "variant": "titleMedium" },
                      {
                        "type": "ListTile",
                        "leading": { "type": "Icon", "name": "tag" },
                        "title": { "en": "Account Number", "tr": "Hesap Numarası" },
                        "subtitle": "$instance.accountCreation.accountNumber"
                      },
                      {
                        "type": "ListTile",
                        "leading": { "type": "Icon", "name": "credit_card" },
                        "title": { "en": "IBAN", "tr": "IBAN" },
                        "subtitle": "$instance.accountCreation.iban"
                      },
                      {
                        "type": "ListTile",
                        "leading": { "type": "Icon", "name": "credit_card" },
                        "title": { "en": "Currency", "tr": "Para Birimi" },
                        "subtitle": "$instance.accountCreation.currency"
                      },
                      {
                        "type": "ListTile",
                        "leading": { "type": "Icon", "name": "check_circle" },
                        "title": { "en": "Status", "tr": "Durum" },
                        "subtitle": "$instance.accountCreation.status"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "Card",
                "variant": "outlined",
                "children": [
                  {
                    "type": "Column",
                    "gap": "xs",
                    "children": [
                      { "type": "Text", "content": { "en": "Next Steps", "tr": "Sonraki Adımlar" }, "variant": "titleMedium" },
                      {
                        "type": "ListTile",
                        "leading": { "type": "Icon", "name": "credit_card" },
                        "title": { "en": "Order your debit card", "tr": "Banka kartınızı sipariş edin" }
                      },
                      {
                        "type": "ListTile",
                        "leading": { "type": "Icon", "name": "smartphone" },
                        "title": { "en": "Manage the account from mobile banking", "tr": "Hesabı mobil bankacılıktan yönetin" }
                      },
                      {
                        "type": "ListTile",
                        "leading": { "type": "Icon", "name": "star" },
                        "title": { "en": "Make your first deposit", "tr": "İlk para yatırma işleminizi yapın" }
                      }
                    ]
                  }
                ]
              },
              {
                "type": "Row",
                "gap": "sm",
                "mainAxisAlignment": "end",
                "children": [
                  {
                    "type": "Button",
                    "label": { "en": "Continue to Banking", "tr": "Bankacılığa Devam Et" },
                    "variant": "filled",
                    "icon": "arrow_forward",
                    "action": "submit",
                    "command": "urn:forge:nav:/dashboard"
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  }
}
