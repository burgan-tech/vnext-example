{
  "key": "account-type-selection-view",
  "version": "1.0.0",
  "domain": "core",
  "flow": "sys-views",
  "flowVersion": "1.0.0",
  "tags": [
    "banking",
    "account-type",
    "selection",
    "navigation",
    "ui-view"
  ],
  "attributes": {
    "type": 1,
    "labels": [
      {
        "language": "en-US",
        "label": "Select Account Type"
      },
      {
        "language": "tr-TR",
        "label": "Hesap Türü Seçimi"
      }
    ],
    "display": {
      "sdi": "full-page",
      "mdi": "full-page"
    },
    "renderer": "pseudo-ui",
    "content": {
      "$schema": "https://amorphie.io/meta/view-vocabulary/1.0",
      "dataSchema": "urn:vnext:res:schema:core:account-type-selection",
      "view": {
        "type": "ScrollView",
        "children": [
          {
            "type": "Column",
            "gap": "md",
            "children": [
              {
                "type": "Text",
                "content": {
                  "en": "Step 1 of 4 — Account Type",
                  "tr": "Adım 1 / 4 — Hesap Türü"
                },
                "variant": "labelLarge"
              },
              {
                "type": "Text",
                "content": {
                  "en": "Choose Your Account Type",
                  "tr": "Hesap Türünüzü Seçin"
                },
                "variant": "headlineMedium"
              },
              {
                "type": "Text",
                "content": {
                  "en": "Tap a card to continue. Each card dispatches its own workflow transition.",
                  "tr": "Devam etmek için bir karta dokunun. Her kart kendi workflow transition'ını gönderir."
                },
                "variant": "bodyMedium"
              },
              {
                "type": "Grid",
                "columns": 2,
                "gap": "md",
                "children": [
                  {
                    "type": "Card",
                    "variant": "outlined",
                    "children": [
                      {
                        "type": "Column",
                        "gap": "sm",
                        "children": [
                          {
                            "type": "Icon",
                            "name": "home",
                            "size": "lg"
                          },
                          {
                            "type": "Text",
                            "content": {
                              "en": "Demand Deposit",
                              "tr": "Vadesiz Mevduat"
                            },
                            "variant": "titleMedium"
                          },
                          {
                            "type": "Text",
                            "content": {
                              "en": "Access your money anytime with everyday banking services.",
                              "tr": "Günlük bankacılık hizmetleriyle paranıza istediğiniz zaman erişin."
                            },
                            "variant": "bodyMedium"
                          }
                        ]
                      }
                    ],
                    "action": {
                      "action": "dispatch",
                      "command": "urn:vnext:flow:transition:core:account-opening:select-demand-deposit"
                    }
                  },
                  {
                    "type": "Card",
                    "variant": "outlined",
                    "children": [
                      {
                        "type": "Column",
                        "gap": "sm",
                        "children": [
                          {
                            "type": "Icon",
                            "name": "star",
                            "size": "lg"
                          },
                          {
                            "type": "Text",
                            "content": {
                              "en": "Savings Account",
                              "tr": "Birikim Hesabı"
                            },
                            "variant": "titleMedium"
                          },
                          {
                            "type": "Text",
                            "content": {
                              "en": "Set aside money and track your savings goal.",
                              "tr": "Birikim hedefiniz için para ayırın ve ilerlemenizi takip edin."
                            },
                            "variant": "bodyMedium"
                          }
                        ]
                      }
                    ],
                    "action": {
                      "action": "dispatch",
                      "command": "urn:vnext:flow:transition:core:account-opening:select-savings-account"
                    }
                  },
                  {
                    "type": "Card",
                    "variant": "outlined",
                    "children": [
                      {
                        "type": "Column",
                        "gap": "sm",
                        "children": [
                          {
                            "type": "Icon",
                            "name": "schedule",
                            "size": "lg"
                          },
                          {
                            "type": "Text",
                            "content": {
                              "en": "Time Deposit",
                              "tr": "Vadeli Mevduat"
                            },
                            "variant": "titleMedium"
                          },
                          {
                            "type": "Text",
                            "content": {
                              "en": "Plan deposits for a fixed term with predictable returns.",
                              "tr": "Belirli bir vade için öngörülebilir getiriyle mevduat planlayın."
                            },
                            "variant": "bodyMedium"
                          }
                        ]
                      }
                    ],
                    "action": {
                      "action": "dispatch",
                      "command": "urn:vnext:flow:transition:core:account-opening:select-time-deposit"
                    }
                  },
                  {
                    "type": "Card",
                    "variant": "outlined",
                    "children": [
                      {
                        "type": "Column",
                        "gap": "sm",
                        "children": [
                          {
                            "type": "Icon",
                            "name": "show_chart",
                            "size": "lg"
                          },
                          {
                            "type": "Text",
                            "content": {
                              "en": "Investment Account",
                              "tr": "Yatırım Hesabı"
                            },
                            "variant": "titleMedium"
                          },
                          {
                            "type": "Text",
                            "content": {
                              "en": "Access investment products with a profile-driven setup.",
                              "tr": "Profile dayalı kurulumla yatırım ürünlerine erişin."
                            },
                            "variant": "bodyMedium"
                          }
                        ]
                      }
                    ],
                    "action": {
                      "action": "dispatch",
                      "command": "urn:vnext:flow:transition:core:account-opening:select-investment-account"
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  }
}