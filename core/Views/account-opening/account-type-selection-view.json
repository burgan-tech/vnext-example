{
  "key": "account-type-selection-view",
  "version": "1.0.0",
  "domain": "core",
  "flow": "sys-views",
  "flowVersion": "1.0.0",
  "tags": [
    "banking",
    "account-type",
    "selection",
    "ui-view"
  ],
  "attributes": {
    "type": 1,
    "labels": [
      {
        "language": "en-US",
        "label": "Select Account Type"
      }
    ],
    "display": "full-page",
    "content": {
      "type": "form",
      "title": {
        "en-US": "Choose Your Account Type"
      },
      "description": {
        "en-US": "Select the type of account that best suits your needs."
      },
      "fields": [
        {
          "key": "accountType",
          "type": "radio-group",
          "label": {
            "en-US": "Account Type"
          },
          "required": true,
          "options": [
            {
              "value": "demand-deposit",
              "label": {
                "en-US": "Demand Deposit Account"
              },
              "description": {
                "en-US": "Access your money anytime with no minimum balance requirement"
              },
              "icon": "credit-card"
            },
            {
              "value": "savings",
              "label": {
                "en-US": "Savings Account"
              },
              "description": {
                "en-US": "Earn interest on your deposits with competitive rates"
              },
              "icon": "piggy-bank",
              "disabled": true,
              "disabledReason": {
                "en-US": "Coming soon"
              }
            }
          ]
        }
      ],
      "buttons": [
        {
          "key": "select-demand-deposit",
          "label": {
            "en-US": "Continue"
          },
          "style": "primary",
          "action": "submit",
          "transition": "select-demand-deposit",
          "requiresValidForm": true
        }
      ]
    }
  }
}
