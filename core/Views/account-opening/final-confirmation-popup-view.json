{
  "key": "final-confirmation-popup-view",
  "version": "1.0.0",
  "domain": "core",
  "flow": "sys-views",
  "flowVersion": "1.0.0",
  "tags": [
    "banking",
    "final-confirmation",
    "terms",
    "popup",
    "ui-view"
  ],
  "attributes": {
    "type": 1,
    "labels": [
      { "language": "en-US", "label": "Final Confirmation" }
    ],
    "display": "popup",
    "renderer": "pseudo-ui",
    "content": {
      "$schema": "https://amorphie.io/meta/view-vocabulary/1.0",
      "dataSchema": "urn:vnext:res:schema:core:account-confirmation",
      "view": {
        "type": "Column",
        "gap": "md",
        "children": [
          {
            "type": "Text",
            "content": { "en": "Final Confirmation", "tr": "Son Onay" },
            "variant": "headlineSmall"
          },
          {
            "type": "Text",
            "content": {
              "en": "Confirm that the information is accurate and accept the required terms to open the account.",
              "tr": "Hesabı açmak için bilgilerin doğru olduğunu onaylayın ve gerekli koşulları kabul edin."
            },
            "variant": "bodyMedium"
          },
          {
            "type": "Card",
            "variant": "outlined",
            "children": [
              {
                "type": "Column",
                "gap": "sm",
                "children": [
                  { "type": "Checkbox", "bind": "confirmed" },
                  { "type": "Checkbox", "bind": "termsAccepted" },
                  { "type": "Checkbox", "bind": "privacyPolicyAccepted" }
                ]
              }
            ]
          },
          {
            "type": "Row",
            "gap": "sm",
            "mainAxisAlignment": "spaceBetween",
            "children": [
              {
                "type": "Button",
                "label": { "en": "Cancel", "tr": "İptal" },
                "variant": "outlined",
                "action": "cancel",
                "command": "urn:vnext:flow:transition:core:account-opening:cancel-account-opening"
              },
              {
                "type": "Button",
                "label": { "en": "Open Account", "tr": "Hesap Aç" },
                "variant": "filled",
                "icon": "check_circle",
                "action": "submit",
                "command": "urn:vnext:flow:transition:core:account-opening:approve-account-opening"
              }
            ]
          }
        ]
      }
    }
  }
}
