{
  "key": "fanout-case-item-boundary-retry-task",
  "version": "1.0.0",
  "domain": "core",
  "flow": "sys-tasks",
  "flowVersion": "1.0.0",
  "tags": [
    "integration-test",
    "fan-out-config-matrix",
    "fan-out",
    "task-type-21",
    "item-error-boundary",
    "retry"
  ],
  "attributes": {
    "type": "21",
    "config": {
      "mode": "inline",
      "itemsPath": "$.documents",
      "itemAlias": "document",
      "task": {
        "key": "process-document-task",
        "domain": "core",
        "flow": "sys-tasks",
        "version": "1.0.0"
      },
      "execution": {
        "maxDegreeOfParallelism": 4,
        "itemTimeoutSeconds": 10,
        "batchTimeoutSeconds": 60
      },
      "join": {
        "policy": "allSettled",
        "resultKey": "caseResults",
        "ordered": true
      },
      "errorBoundary": {
        "onError": [
          {
            "action": "retry",
            "errorCodes": [
              "*"
            ],
            "priority": 999,
            "retryPolicy": {
              "maxRetries": 2,
              "initialDelay": "PT0.2S",
              "backoffType": "fixed",
              "maxDelay": "PT1S",
              "useJitter": false
            }
          }
        ]
      }
    }
  }
}
