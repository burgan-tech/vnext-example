{
  "key": "script-perf-fanout-task",
  "version": "1.0.0",
  "domain": "core",
  "flow": "sys-tasks",
  "flowVersion": "1.0.0",
  "tags": [
    "integration-test",
    "script-perf-lab",
    "performance-baseline",
    "fan-out",
    "task-type-21",
    "all-settled"
  ],
  "attributes": {
    "type": "21",
    "config": {
      "mode": "inline",
      "itemsPath": "$.fanoutItems",
      "itemAlias": "item",
      "task": {
        "key": "perf-item-http-task",
        "domain": "core",
        "flow": "sys-tasks",
        "version": "1.0.0"
      },
      "execution": {
        "maxDegreeOfParallelism": 4,
        "itemTimeoutSeconds": 20,
        "batchTimeoutSeconds": 120
      },
      "join": {
        "policy": "allSettled",
        "resultKey": "perfItemResults",
        "ordered": true
      }
    }
  }
}
