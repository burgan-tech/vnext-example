{
  "key": "fan-out-documents-task",
  "version": "1.0.0",
  "domain": "core",
  "flow": "sys-tasks",
  "flowVersion": "1.0.0",
  "tags": [
    "integration-test",
    "fan-out-documents",
    "fan-out",
    "task-type-21",
    "all-settled",
    "single-write-invariant"
  ],
  "attributes": {
    "type": "21",
    "config": {
      "mode": "inline",
      "itemsPath": "$.documents",
      "itemAlias": "document",
      "task": {
        "key": "process-document-task",
        "domain": "core",
        "flow": "sys-tasks",
        "version": "1.0.0"
      },
      "execution": {
        "maxDegreeOfParallelism": 3,
        "itemTimeoutSeconds": 15,
        "batchTimeoutSeconds": 60
      },
      "join": {
        "policy": "allSettled",
        "resultKey": "documentResults",
        "ordered": true
      }
    }
  }
}
