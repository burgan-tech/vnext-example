  "attributes": {
    "_comment": "timeout is NULL on purpose, and that is the whole point of this fixture. The deadline this child runs under comes from its PARENT's subFlow.overrides.timeout. Until the effective-timeout resolver landed, that override was read only when the job was armed: the job fired on schedule, the handler read THIS definition, found no timeout and returned — so the child sat here forever with a deadline that could never arrive. Do not 'fix' this file by giving the child its own timeout; that would delete the regression.",
    "type": "S",
    "timeout": null,
    "labels": [
      {
        "language": "en-US",
        "label": "Timeout Lab — child with no timeout of its own"
      }
    ],
