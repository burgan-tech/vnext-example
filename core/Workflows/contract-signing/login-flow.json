        "subType": 0,
        "versionStrategy": "Minor",
        "labels": [
          {
            "language": "en-US",
            "label": "All Documents Approved"
          }
        ],
        "view": null,
        "subFlow": null,
        "onEntries": [],
        "onExits": [],
        "transitions": [
          {
