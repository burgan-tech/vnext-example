{
  "key": "login-flow",
  "flow": "sys-flows",
  "flowVersion": "1.0.0",
  "domain": "core",
  "version": "1.1.0",
  "tags": [
    "contract-signing",
    "login-flow",
    "orchestration",
    "subprocess"
  ],
  "attributes": {
    "type": "F",
    "timeout": null,
    "labels": [
      {
        "language": "en-US",
        "label": "Login Flow"
      }
    ],
    "functions": [],
    "features": [],
    "sharedTransitions": [
      {
        "_comment": "contract-flow reports that every document finished rendering.",
        "key": "login-ready",
        "target": "waiting-approval-doc",
        "triggerType": 0,
        "versionStrategy": "Minor",
        "availableIn": [
          "awaiting-ready"
        ],
        "labels": [
          {
            "language": "en-US",
            "label": "Contract Documents Ready (callback)"
          }
        ],
        "onExecutionTasks": []
      },
      {
        "_comment": "contract-flow reports that every document has been approved (single aggregate signal).",
        "key": "login-approvals-done",
        "target": "all-documents-approved",
        "triggerType": 0,
        "versionStrategy": "Minor",
        "availableIn": [
          "waiting-approval-doc"
        ],
        "labels": [
          {
            "language": "en-US",
            "label": "All Documents Approved (callback)"
          }
        ],
        "onExecutionTasks": []
      }
    ],
    "extensions": [],
    "startTransition": {
      "key": "start-login",
      "target": "login-initial",
      "triggerType": 0,
      "versionStrategy": "Minor",
      "labels": [
        {
          "language": "en-US",
          "label": "Start Login Flow"
        }
      ],
      "schema": {
        "key": "start-login-payload",
        "version": "1.0.0",
        "domain": "core",
        "flow": "sys-schemas"
      }
    },
    "cancel": {
      "key": "cancel-login",
      "target": "login-cancelled",
      "triggerType": 0,
      "versionStrategy": "Minor",
      "labels": [
        {
          "language": "en-US",
          "label": "Cancel Login"
        }
      ]
    },
    "updateData": {
      "_comment": "contract-flow pushes a contractCompleted flag here just before closing itself. Data-only handoff: login-flow decides when to move on via the gated auto transition on awaiting-completed.",
      "key": "contract-status",
      "target": "$self",
      "versionStrategy": "Minor",
      "triggerType": 0,
      "schema": null,
      "labels": [
        {
          "language": "en-US",
          "label": "Contract Status Update (from child)"
        }
      ],
      "onExecutionTasks": [
        {
          "order": 1,
          "task": {
            "key": "signing-script-task",
            "domain": "core",
            "version": "1.0.0",
            "flow": "sys-tasks"
          },
          "mapping": {
            "location": "./src/LoginContractStatusMapping.csx",
            "code": "",
            "encoding": "B64"
          }
        }
      ]
    },
    "states": [
      {
        "key": "login-initial",
        "stateType": 1,
        "subType": 0,
        "versionStrategy": "Minor",
        "labels": [
          {
            "language": "en-US",
            "label": "Login Initial"
          }
        ],
        "view": null,
        "subFlow": null,
        "onEntries": [
          {
            "order": 1,
            "task": {
              "key": "start-subprocess",
              "domain": "core",
              "version": "1.0.0",
              "flow": "sys-tasks"
            },
            "mapping": {
              "location": "./src/LoginStartContractMapping.csx",
              "code": "",
              "encoding": "B64"
            },
            "errorBoundary": {
              "onError": [
                {
                  "action": 1,
                  "errorCodes": [
                    "409"
                  ],
                  "priority": 10,
                  "retryPolicy": {
                    "maxRetries": 8,
                    "initialDelay": "PT0.5S",
                    "backoffType": 1,
                    "backoffMultiplier": 2,
                    "maxDelay": "PT10S",
                    "useJitter": true
                  }
                }
              ]
            }
          }
        ],
        "onExits": [],
        "transitions": [
          {
            "key": "login-initial-to-awaiting-ready",
            "target": "awaiting-ready",
            "triggerType": 1,
            "versionStrategy": "Minor",
            "labels": [
              {
                "language": "en-US",
                "label": "Auto to Awaiting Ready"
              }
            ],
            "rule": {
              "location": "./src/AlwaysTrueRule.csx",
              "code": ""
            },
            "onExecutionTasks": []
          }
        ]
      },
      {
        "key": "awaiting-ready",
        "stateType": 2,
        "subType": 0,
        "versionStrategy": "Minor",
        "labels": [
          {
            "language": "en-US",
            "label": "Awaiting Contract Ready"
          }
        ],
        "view": null,
        "subFlow": null,
        "onEntries": [],
        "onExits": [],
        "transitions": []
      },
      {
        "key": "waiting-approval-doc",
        "stateType": 2,
        "subType": 0,
        "versionStrategy": "Minor",
        "labels": [
          {
