            "rule": {
              "location": "./src/ContractCompletedRule.csx",
              "code": ""
            },
            "onExecutionTasks": []
          },
          {
            "key": "login-completed",
            "target": "login-completed-state",
            "triggerType": 0,
            "versionStrategy": "Minor",
            "labels": [
              {
                "language": "en-US",
                "label": "Contract Completed (manual override)"
              }
            ],
            "onExecutionTasks": []
          }
        ]
      },
      {
        "key": "login-completed-state",
        "stateType": 3,
        "subType": 1,
        "versionStrategy": "Minor",
        "labels": [
          {
            "language": "en-US",
            "label": "Login Completed"
          }
        ],
        "view": null,
        "subFlow": null,
        "onEntries": [],
        "onExits": [],
        "transitions": []
      },
      {
