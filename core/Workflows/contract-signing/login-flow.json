                "language": "en-US",
                "label": "Finalize Contract"
              }
            ],
            "onExecutionTasks": [
              {
                "order": 1,
                "task": {
                  "key": "trigger-transition",
                  "domain": "core",
                  "version": "1.0.0",
                  "flow": "sys-tasks"
                },
                "mapping": {
                  "location": "./src/LoginTriggerContractFinalizeMapping.csx",
                  "code": "",
                  "encoding": "B64"
                },
                "errorBoundary": {
                  "onError": [
                    {
                      "action": 1,
                      "errorCodes": [
                        "409"
                      ],
                      "priority": 10,
                      "retryPolicy": {
                        "maxRetries": 8,
                        "initialDelay": "PT0.5S",
                        "backoffType": 1,
                        "backoffMultiplier": 2,
                        "maxDelay": "PT10S",
                        "useJitter": true
                      }
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      {
        "key": "awaiting-completed",
        "stateType": 2,
        "subType": 0,
        "versionStrategy": "Minor",
