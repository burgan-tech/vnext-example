{
  "key": "ai-agent-lab-script",
  "flow": "sys-flows",
  "flowVersion": "1.0.0",
  "domain": "core",
  "version": "1.0.0",
  "tags": [
    "integration-test",
    "ai-agent-lab",
    "ai-agent"
  ],
  "attributes": {
    "type": "F",
    "timeout": null,
    "labels": [
      {
        "language": "en-US",
        "label": "AI Agent Lab (script decision)"
      }
    ],
    "functions": [],
    "features": [],
    "extensions": [],
    "startTransition": {
      "key": "start-ai-agent-lab-script",
      "target": "classifying",
      "triggerType": 0,
      "versionStrategy": "Major",
      "labels": [
        {
          "language": "en-US",
          "label": "Start ai-agent-lab-script"
        }
      ],
      "onExecutionTasks": []
    },
    "states": [
      {
        "key": "classifying",
        "stateType": 6,
        "subType": 5,
        "versionStrategy": "Major",
        "labels": [
          {
            "language": "en-US",
            "label": "Classifying (AiAgent, script decision)"
          }
        ],
        "view": null,
        "subFlow": null,
        "onEntries": [],
        "onExits": [],
        "transitions": [
          {
            "key": "is-question",
            "target": "answered",
            "triggerType": 1,
            "versionStrategy": "Minor",
            "labels": [
              {
                "language": "en-US",
                "label": "Is a question"
              }
            ],
            "onExecutionTasks": []
          },
          {
            "key": "is-fraud",
            "target": "escalated",
            "triggerType": 1,
            "versionStrategy": "Minor",
            "labels": [
              {
                "language": "en-US",
                "label": "Is fraud"
              }
            ],
            "onExecutionTasks": []
          },
          {
            "key": "classify-failed",
            "target": "failed",
            "triggerType": 1,
            "versionStrategy": "Minor",
            "labels": [
              {
                "language": "en-US",
                "label": "Classification failed"
              }
            ],
            "onExecutionTasks": []
          }
        ],
        "agent": {
          "agent": {
            "key": "ai-triage-agent",
            "domain": "core",
            "flow": "sys-agents",
            "version": "1.0.0"
          },
          "prompt": {
            "template": "<message>{{ data.message }}</message>"
          },
          "output": {
            "path": "$.triage"
          },
          "tools": {
            "exclude": [
              "lab_script"
            ]
          },
          "decision": {
            "mode": "script",
            "fallback": "classify-failed",
            "mapping": {
              "location": "./src/ScriptDecision.csx",
              "code": ""
            }
          }
        }
      },
      {
        "key": "answered",
        "stateType": 3,
        "subType": 1,
        "versionStrategy": "Major",
        "labels": [
          {
            "language": "en-US",
            "label": "Answered"
          }
        ],
        "view": null,
        "subFlow": null,
        "onEntries": [],
        "onExits": [],
        "transitions": []
      },
      {
        "key": "escalated",
        "stateType": 3,
        "subType": 1,
        "versionStrategy": "Major",
        "labels": [
          {
            "language": "en-US",
            "label": "Escalated"
          }
        ],
        "view": null,
        "subFlow": null,
        "onEntries": [],
        "onExits": [],
        "transitions": []
      },
      {
        "key": "failed",
        "stateType": 3,
        "subType": 1,
        "versionStrategy": "Major",
        "labels": [
          {
            "language": "en-US",
            "label": "Failed"
          }
        ],
        "view": null,
        "subFlow": null,
        "onEntries": [],
        "onExits": [],
        "transitions": []
      }
    ]
  }
}
