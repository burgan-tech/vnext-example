{
  "key": "ai-agent-lab-approval",
  "flow": "sys-flows",
  "flowVersion": "1.0.0",
  "domain": "core",
  "version": "1.0.0",
  "tags": [
    "integration-test",
    "ai-agent-lab",
    "ai-agent"
  ],
  "attributes": {
    "type": "F",
    "timeout": null,
    "labels": [
      {
        "language": "en-US",
        "label": "AI Agent Lab (tool approval)"
      }
    ],
    "functions": [],
    "features": [],
    "extensions": [],
    "startTransition": {
      "key": "start-ai-agent-lab-approval",
      "target": "assessing",
      "triggerType": 0,
      "versionStrategy": "Major",
      "labels": [
        {
          "language": "en-US",
          "label": "Start ai-agent-lab-approval"
        }
      ],
      "onExecutionTasks": []
    },
    "states": [
      {
        "key": "assessing",
        "stateType": 6,
        "subType": 5,
        "versionStrategy": "Major",
        "labels": [
          {
            "language": "en-US",
            "label": "Assessing (AiAgent, approval-required tool)"
          }
        ],
        "view": null,
        "subFlow": null,
        "onEntries": [],
        "onExits": [],
        "transitions": [
          {
            "key": "is-question",
            "target": "answered",
            "triggerType": 1,
            "versionStrategy": "Minor",
            "labels": [
              {
                "language": "en-US",
                "label": "Is a question"
              }
            ],
            "onExecutionTasks": []
          },
          {
            "key": "is-fraud",
            "target": "escalated",
            "triggerType": 1,
            "versionStrategy": "Minor",
            "labels": [
              {
                "language": "en-US",
                "label": "Is fraud"
              }
            ],
            "onExecutionTasks": []
          },
          {
            "key": "needs-approval",
            "target": "review",
            "triggerType": 1,
            "versionStrategy": "Minor",
            "labels": [
              {
                "language": "en-US",
                "label": "A tool call waits for approval"
              }
            ],
            "onExecutionTasks": []
          },
          {
            "key": "assess-failed",
            "target": "failed",
            "triggerType": 1,
            "versionStrategy": "Minor",
            "labels": [
              {
                "language": "en-US",
                "label": "Assessment failed"
              }
            ],
            "onExecutionTasks": []
          }
        ],
        "agent": {
          "agent": {
            "key": "ai-approval-agent",
            "domain": "core",
            "flow": "sys-agents",
            "version": "1.0.0"
          },
          "prompt": {
            "template": "<request>{{ data.message }}</request>",
            "messages": [
              {
                "role": "user",
                "content": "Example request: what is my limit?"
              },
              {
                "role": "assistant",
                "content": "{\"category\":\"question\"}"
              }
            ],
            "context": {
              "customer": "data.customer"
            }
          },
          "output": {
            "path": "$.assessment"
          },
          "decision": {
            "mode": "model",
            "fallback": "assess-failed",
            "onApprovalRequest": "needs-approval"
          }
        }
      },
      {
        "key": "review",
        "stateType": 2,
        "subType": 0,
        "versionStrategy": "Major",
        "labels": [
          {
            "language": "en-US",
            "label": "Review (any state; here a plain intermediate one)"
          }
        ],
        "view": null,
        "subFlow": null,
        "onEntries": [],
        "onExits": [],
        "transitions": [
          {
            "key": "decide",
            "target": "assessing",
            "triggerType": 0,
            "versionStrategy": "Minor",
            "labels": [
              {
                "language": "en-US",
                "label": "Answer the approval"
              }
            ],
            "onExecutionTasks": []
          }
        ]
      },
      {
        "key": "answered",
        "stateType": 3,
        "subType": 1,
        "versionStrategy": "Major",
        "labels": [
          {
            "language": "en-US",
            "label": "Answered"
          }
        ],
        "view": null,
        "subFlow": null,
        "onEntries": [],
        "onExits": [],
        "transitions": []
      },
      {
        "key": "escalated",
        "stateType": 3,
        "subType": 1,
        "versionStrategy": "Major",
        "labels": [
          {
            "language": "en-US",
            "label": "Escalated"
          }
        ],
        "view": null,
        "subFlow": null,
        "onEntries": [],
        "onExits": [],
        "transitions": []
      },
      {
        "key": "failed",
        "stateType": 3,
        "subType": 1,
        "versionStrategy": "Major",
        "labels": [
          {
            "language": "en-US",
            "label": "Failed"
          }
        ],
        "view": null,
        "subFlow": null,
        "onEntries": [],
        "onExits": [],
        "transitions": []
      }
    ]
  }
}
