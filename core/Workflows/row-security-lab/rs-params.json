{
  "key": "rs-params",
  "flow": "sys-flows",
  "flowVersion": "1.0.0",
  "domain": "core",
  "version": "1.0.0",
  "tags": [
    "integration-test",
    "row-security-lab"
  ],
  "attributes": {
    "type": "F",
    "labels": [
      {
        "language": "en-US",
        "label": "Row Security Lab parameter shapes"
      }
    ],
    "schema": {
      "key": "rs-lab-schema-plain",
      "domain": "core",
      "version": "1.0.0",
      "flow": "sys-schemas"
    },
    "functions": [],
    "features": [],
    "extensions": [],
    "rowSecurity": {
      "rules": [
        {
          "roles": [
            "hq-auditor"
          ]
        },
        {
          "roles": [
            "rs-p-header-eq"
          ],
          "filter": {
            "attributes": {
              "branchCode": {
                "eq": "$.context.Headers.x-branch-code"
              }
            }
          }
        },
        {
          "roles": [
            "rs-p-query-branch"
          ],
          "filter": {
            "attributes": {
              "branchCode": {
                "eq": "$.context.QueryParameters.branch"
              }
            }
          }
        },
        {
          "roles": [
            "rs-p-query-br"
          ],
          "filter": {
            "attributes": {
              "branchCode": {
                "eq": "$.context.QueryParameters.br"
              }
            }
          }
        },
        {
          "roles": [
            "rs-p-in-elements"
          ],
          "filter": {
            "attributes": {
              "branchCode": {
                "in": [
                  "$.context.Headers.x-b1",
                  "$.context.Headers.x-b2"
                ]
              }
            }
          }
        },
        {
          "roles": [
            "rs-p-in-literal"
          ],
          "filter": {
            "attributes": {
              "branchCode": {
                "in": [
                  "$.context.Headers.x-b1",
                  "BR-999"
                ]
              }
            }
          }
        },
        {
          "roles": [
            "rs-p-in-split"
          ],
          "filter": {
            "attributes": {
              "branchCode": {
                "in": {
                  "$param": "$.context.Headers.x-branches",
                  "split": ","
                }
              }
            }
          }
        },
        {
          "roles": [
            "rs-p-in-param"
          ],
          "filter": {
            "attributes": {
              "branchCode": {
                "in": {
                  "$param": "$.context.Headers.x-branches"
                }
              }
            }
          }
        },
        {
          "roles": [
            "rs-p-nin-elements"
          ],
          "filter": {
            "attributes": {
              "branchCode": {
                "nin": [
                  "$.context.Headers.x-excl-1",
                  "$.context.Headers.x-excl-2"
                ]
              }
            }
          }
        },
        {
          "roles": [
            "rs-p-ne"
          ],
          "filter": {
            "attributes": {
              "branchCode": {
                "ne": "$.context.Headers.x-branch-code"
              }
            }
          }
        },
        {
          "roles": [
            "rs-p-between"
          ],
          "filter": {
            "attributes": {
              "amount": {
                "between": [
                  "$.context.Headers.x-min",
                  "$.context.Headers.x-max"
                ]
              }
            }
          }
        },
        {
          "roles": [
            "rs-p-ge-number"
          ],
          "filter": {
            "attributes": {
              "amount": {
                "ge": "$.context.Headers.x-min"
              }
            }
          }
        },
        {
          "roles": [
            "rs-p-not-in"
          ],
          "filter": {
            "not": {
              "attributes": {
                "branchCode": {
                  "in": [
                    "$.context.Headers.x-b1",
                    "$.context.Headers.x-b2"
                  ]
                }
              }
            }
          }
        },
        {
          "roles": [
            "rs-p-not-eq"
          ],
          "filter": {
            "not": {
              "attributes": {
                "branchCode": {
                  "eq": "$.context.Headers.x-branch-code"
                }
              }
            }
          }
        },
        {
          "roles": [
            "rs-p-and-or"
          ],
          "filter": {
            "and": [
              {
                "attributes": {
                  "branchCode": {
                    "eq": "$.context.Headers.x-branch-code"
                  }
                }
              },
              {
                "or": [
                  {
                    "attributes": {
                      "region": {
                        "eq": "$.context.Headers.x-region"
                      }
                    }
                  },
                  {
                    "attributes": {
                      "amount": {
                        "ge": "$.context.Headers.x-min"
                      }
                    }
                  }
                ]
              }
            ]
          }
        },
        {
          "roles": [
            "rs-p-region"
          ],
          "filter": {
            "attributes": {
              "region": {
                "eq": "$.context.Headers.x-region"
              }
            }
          }
        },
        {
          "roles": [
            "rs-p-position"
          ],
          "filter": {
            "attributes": {
              "positionCode": {
                "eq": "$.context.CurrentUser.Position"
              }
            }
          }
        },
        {
          "roles": [
            "rs-p-actor"
          ],
          "filter": {
            "attributes": {
              "owner": {
                "eq": "$.context.CurrentUser.ActorUserName"
              }
            }
          }
        },
        {
          "roles": [
            "rs-p-username"
          ],
          "filter": {
            "attributes": {
              "owner": {
                "eq": "$.context.CurrentUser.UserName"
              }
            }
          }
        }
      ]
    },
    "startTransition": {
      "key": "start",
      "target": "active",
      "triggerType": 0,
      "versionStrategy": "Major",
      "labels": [
        {
          "language": "en-US",
          "label": "Start"
        }
      ]
    },
    "updateData": {
      "key": "rs-update",
      "target": "$self",
      "triggerType": 0,
      "versionStrategy": "Minor",
      "labels": [
        {
          "language": "en-US",
          "label": "Update data"
        }
      ]
    },
    "states": [
      {
        "key": "active",
        "stateType": 1,
        "subType": 0,
        "versionStrategy": "Major",
        "labels": [
          {
            "language": "en-US",
            "label": "Active"
          }
        ],
        "view": null,
        "subFlow": null,
        "onEntries": [],
        "onExits": [],
        "transitions": [
          {
            "key": "rs-close",
            "target": "closed",
            "triggerType": 0,
            "versionStrategy": "Minor",
            "labels": [
              {
                "language": "en-US",
                "label": "Close"
              }
            ],
            "onExecutionTasks": []
          }
        ]
      },
      {
        "key": "closed",
        "stateType": 3,
        "subType": 1,
        "versionStrategy": "Major",
        "labels": [
          {
            "language": "en-US",
            "label": "Closed"
          }
        ],
        "view": null,
        "subFlow": null,
        "onEntries": [],
        "onExits": [],
        "transitions": []
      }
    ]
  }
}
