{
  "key": "money-transfer",
  "flow": "sys-flows",
  "flowVersion": "1.0.0",
  "domain": "core",
  "version": "1.0.0",
  "tags": [
    "money-transfer",
    "payments",
    "flow"
  ],
  "attributes": {
    "type": "F",
    "errorBoundary": {
      "onError": [
        {
          "action": 0,
          "priority": 100
        }
      ]
    },
    "schema": {
      "key": "money-transfer-master",
      "domain": "core",
      "flow": "sys-schemas",
      "version": "1.0.0"
    },
    "functions": [
      {
        "key": "get-source-accounts",
        "domain": "core",
        "flow": "sys-functions",
        "version": "1.0.0"
      },
      {
        "key": "get-favorite-beneficiaries",
        "domain": "core",
        "flow": "sys-functions",
        "version": "1.0.0"
      }
    ],
    "labels": [
      {
        "label": "Para Transferi",
        "language": "tr"
      },
      {
        "label": "Money Transfer",
        "language": "en"
      }
    ],
    "startTransition": {
      "key": "start",
      "target": "enter-transfer-details",
      "triggerType": 0,
      "versionStrategy": "Minor",
      "labels": [
        {
          "label": "Transferi Başlat",
          "language": "tr"
        },
        {
          "label": "Start Transfer",
          "language": "en"
        }
      ]
    },
    "cancel": {
      "key": "cancel-transfer",
      "target": "transfer-cancelled",
      "triggerType": 0,
      "versionStrategy": "Minor",
      "labels": [
        {
          "label": "Transferi İptal Et",
          "language": "tr"
        },
        {
          "label": "Cancel Transfer",
          "language": "en"
        }
      ]
    },
    "states": [
      {
        "key": "enter-transfer-details",
        "stateType": 1,
        "subType": 0,
        "versionStrategy": "Minor",
        "labels": [
          {
            "label": "Transfer Bilgileri",
            "language": "tr"
          },
          {
            "label": "Enter Transfer Details",
            "language": "en"
          }
        ],
        "view": {
          "view": {
            "key": "money-transfer-input-view",
            "domain": "core",
            "version": "1.0.0",
            "flow": "sys-views"
          },
          "loadData": false
        },
        "transitions": [
          {
            "key": "submit-details",
            "target": "review-and-confirm",
            "triggerType": 0,
            "versionStrategy": "Minor",
            "labels": [
              {
                "label": "Devam Et",
                "language": "tr"
              },
              {
                "label": "Continue",
                "language": "en"
              }
            ],
            "schema": {
              "key": "money-transfer-input",
              "domain": "core",
              "flow": "sys-schemas",
              "version": "1.0.0"
            }
          }
        ],
        "alias": [
          {
            "name": "Transfer Detail",
            "roles": [
              {
                "role": "morph-core.maker",
                "grant": "allow"
              }
            ],
            "labels": [
              {
                "language": "tr",
                "label": "Transfer Detayı"
              },
              {
                "language": "en",
                "label": "Transfer Detail"
              }
            ]
          }
        ]
      },
      {
        "key": "review-and-confirm",
        "stateType": 2,
        "subType": 0,
        "versionStrategy": "Minor",
        "labels": [
          {
            "label": "Gözden Geçir ve Onayla",
            "language": "tr"
          },
          {
            "label": "Review and Confirm",
            "language": "en"
          }
        ],
        "view": {
          "view": {
            "key": "money-transfer-summary-view",
            "domain": "core",
            "flow": "sys-views",
            "version": "1.0.0"
          }
        },
        "transitions": [
          {
            "key": "confirm",
            "target": "evaluate-push-requirement",
            "triggerType": 0,
            "versionStrategy": "Minor",
            "labels": [
              {
                "label": "Onayla",
                "language": "tr"
              },
              {
                "label": "Confirm",
                "language": "en"
              }
            ],
            "onExecutionTasks": [
              {
                "order": 1,
                "task": {
                  "key": "get-iban-history",
                  "domain": "core",
                  "flow": "sys-tasks",
                  "version": "1.0.0"
                },
                "mapping": {
                  "type": "L",
                  "location": "./src/GetIbanHistoryMapping.csx",
                  "code": ""
                }
              }
            ]
          }
        ],
        "alias": [
          {
            "name": "Review",
            "roles": [
              {
                "role": "morph-core.maker",
                "grant": "allow"
              }
            ],
            "labels": [
              {
                "language": "tr",
                "label": "İnceleme"
              },
              {
                "language": "en",
                "label": "Review"
              }
            ]
          }
        ]
      },
      {
        "key": "evaluate-push-requirement",
        "stateType": 2,
        "subType": 0,
        "versionStrategy": "Minor",
        "labels": [
          {
            "label": "Push Gereksinimi Değerlendiriliyor",
            "language": "tr"
          },
          {
            "label": "Evaluate Push Requirement",
            "language": "en"
          }
        ],
        "view": null,
        "transitions": [
          {
            "key": "require-push",
            "target": "awaiting-push-approval",
            "triggerType": 1,
            "versionStrategy": "Minor",
            "labels": [
              {
                "label": "Push Gerekli (İlk Transfer)",
                "language": "tr"
              },
              {
                "label": "Push Required (First Transfer)",
                "language": "en"
              }
            ],
            "rule": {
              "type": "L",
              "location": "./src/RequirePushRule.csx",
              "code": ""
            }
          },
          {
            "key": "skip-push",
            "target": "executing-transfer",
            "triggerType": 1,
            "versionStrategy": "Minor",
            "labels": [
              {
                "label": "Push Atla (Bilinen IBAN)",
                "language": "tr"
              },
              {
                "label": "Skip Push (Known IBAN)",
                "language": "en"
              }
            ],
            "rule": {
              "type": "L",
              "location": "./src/SkipPushRule.csx",
              "code": ""
            }
          }
        ]
      },
      {
        "key": "awaiting-push-approval",
        "stateType": 2,
        "subType": 0,
        "versionStrategy": "Minor",
        "labels": [
          {
            "label": "Push Onayı Bekleniyor",
            "language": "tr"
          },
          {
            "label": "Awaiting Push Approval",
            "language": "en"
          }
        ],
        "view": {
          "view": {
            "key": "money-transfer-awaiting-push-view",
            "domain": "core",
            "flow": "sys-views",
            "version": "1.0.0"
          }
        },
        "transitions": [
          {
            "key": "approve-push",
            "target": "executing-transfer",
            "triggerType": 0,
            "versionStrategy": "Minor",
            "labels": [
              {
                "label": "Cihazdan Onaylandı",
                "language": "tr"
              },
              {
                "label": "Approved on Device",
                "language": "en"
              }
            ]
          },
          {
            "key": "push-timeout",
            "target": "transfer-failed",
            "triggerType": 2,
            "versionStrategy": "Minor",
            "labels": [
              {
                "label": "Onay Zaman Aşımı",
                "language": "tr"
              },
              {
                "label": "Approval Timeout",
                "language": "en"
              }
            ],
            "timer": {
              "type": "L",
              "location": "./src/PushTimeoutTimer.csx",
              "code": ""
            }
          }
        ]
      },
      {
        "key": "executing-transfer",
        "stateType": 2,
        "subType": 0,
        "versionStrategy": "Minor",
        "labels": [
          {
            "label": "Transfer Gerçekleştiriliyor",
            "language": "tr"
          },
          {
            "label": "Executing Transfer",
            "language": "en"
          }
        ],
        "view": null,
        "errorBoundary": {
          "onError": [
            {
              "action": 4,
              "errorCodes": [
                "400"
              ],
              "transition": "cancel-transfer",
              "priority": 50,
              "logOnly": false
            }
          ]
        },
        "onEntries": [
          {
            "order": 1,
            "task": {
              "key": "execute-transfer",
              "domain": "core",
              "flow": "sys-tasks",
              "version": "1.0.0"
            },
            "mapping": {
              "type": "L",
              "location": "./src/ExecuteTransferMapping.csx",
              "code": ""
            }
          }
        ],
        "transitions": [
          {
            "key": "execution-succeeded",
            "target": "transfer-completed",
            "triggerType": 1,
            "versionStrategy": "Minor",
            "labels": [
              {
                "label": "Transfer Başarılı",
                "language": "tr"
              },
              {
                "label": "Execution Succeeded",
                "language": "en"
              }
            ],
            "rule": {
              "type": "L",
              "location": "./src/ExecutionSucceededRule.csx",
              "code": ""
            }
          },
          {
            "key": "execution-failed",
            "target": "transfer-failed",
            "triggerType": 1,
            "versionStrategy": "Minor",
            "labels": [
              {
                "label": "Transfer Başarısız",
                "language": "tr"
              },
              {
                "label": "Execution Failed",
                "language": "en"
              }
            ],
            "rule": {
              "type": "L",
              "location": "./src/ExecutionFailedRule.csx",
              "code": ""
            }
          }
        ]
      },
      {
        "key": "transfer-completed",
        "stateType": 3,
        "subType": 1,
        "versionStrategy": "Minor",
        "labels": [
          {
            "label": "Transfer Tamamlandı",
            "language": "tr"
          },
          {
            "label": "Transfer Completed",
            "language": "en"
          }
        ],
        "view": {
          "view": {
            "key": "money-transfer-completed-view",
            "domain": "core",
            "flow": "sys-views",
            "version": "1.0.0"
          }
        },
        "transitions": []
      },
      {
        "key": "transfer-failed",
        "stateType": 3,
        "subType": 2,
        "versionStrategy": "Minor",
        "labels": [
          {
            "label": "Transfer Başarısız",
            "language": "tr"
          },
          {
            "label": "Transfer Failed",
            "language": "en"
          }
        ],
        "view": {
          "view": {
            "key": "money-transfer-failed-view",
            "domain": "core",
            "flow": "sys-views",
            "version": "1.0.0"
          }
        },
        "transitions": []
      },
      {
        "key": "transfer-cancelled",
        "stateType": 3,
        "subType": 7,
        "versionStrategy": "Minor",
        "labels": [
          {
            "label": "Transfer İptal Edildi",
            "language": "tr"
          },
          {
            "label": "Transfer Cancelled",
            "language": "en"
          }
        ],
        "view": {
          "view": {
            "key": "money-transfer-cancelled-view",
            "domain": "core",
            "flow": "sys-views",
            "version": "1.0.0"
          }
        },
        "transitions": []
      }
    ]
  }
}