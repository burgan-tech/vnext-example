# Appended to domains/<domain>/.env.orchestration by lab.sh ({{DOMAIN}} is replaced).
# Registers the domain in the `discovery` domain at startup and switches address resolution to Dapr.
ServiceDiscovery__Enabled=true
# Provider is (re)pinned by lab.sh on every `up` from VNEXT_LAB_DISCOVERY_PROVIDER (dapr | http).
ServiceDiscovery__Provider={{PROVIDER}}
ServiceDiscovery__BaseUrl=http://vnext-app-discovery:5000/api/v1
ServiceDiscovery__Domain=discovery
ServiceDiscovery__RegistryFlow=domain-registration
ServiceDiscovery__DiscoveryEndpointTemplate=/discovery/functions/domain-lookup?key={0}
# Lab app-ids are vnext-app-{domain} (runtime template), not the vnext-{domain}-app convention:
# the registry appId override is what makes convention-based resolution land on the right sidecar.
# BOTH flags are needed: the runtime default is RequireRegistryEntry=false (pure convention, no
# registry call), and PreferRegistryAppId is only consulted while the registry is being read.
ServiceDiscovery__Dapr__PreferRegistryAppId=true
ServiceDiscovery__Dapr__RequireRegistryEntry=true
ServiceDiscovery__Dapr__CacheSeconds=5
# Advertised base/health url — must be reachable from the discovery container (not localhost).
vNextApi__BaseUrl=http://vnext-app-{{DOMAIN}}:5000
