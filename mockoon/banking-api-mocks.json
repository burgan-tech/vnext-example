          "filePath": "",
          "databucketID": "",
          "sendFileAsBody": false,
          "rules": [
            {
              "target": "body",
              "modifier": "currency",
              "value": "TRY|USD|EUR|GBP",
              "invert": false,
              "operator": "regex"
            }
