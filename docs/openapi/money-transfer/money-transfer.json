  "components": {
    "schemas": {
      "RequestEnvelopeBase": {
        "type": "object",
        "description": "Common instance request envelope. `attributes` carries the transition payload.",
        "properties": {
          "key": {
            "type": "string",
            "description": "Business-unique key; one active instance per key (optional)."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Instance labels (optional)."
          },
          "stage": {
            "type": "string",
            "description": "Business stage indicator (optional)."
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          }
        }
      },
      "MoneyTransferMasterData": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:vnext:res:schema:core:money-transfer-master",
        "title": "Money Transfer Master",
        "description": "Full instance shape for the money-transfer workflow. Bound by display/summary views.",
        "type": "object",
        "properties": {
          "sourceAccountId": {
            "type": "string",
            "x-labels": {
              "tr": "Kaynak Hesap",
              "en": "Source Account"
            }
          },
          "targetIban": {
            "type": "string",
            "pattern": "^TR[0-9]{24}$",
            "x-labels": {
              "tr": "Alıcı IBAN",
              "en": "Target IBAN"
            }
          },
          "amount": {
            "type": "number",
            "minimum": 0.01,
            "x-labels": {
              "tr": "Tutar",
              "en": "Amount"
            }
          },
          "currency": {
            "type": "string",
            "enum": [
              "TRY",
              "USD",
              "EUR"
            ],
            "default": "TRY",
            "x-labels": {
              "tr": "Para Birimi",
              "en": "Currency"
            }
          },
          "saveBeneficiary": {
            "type": "boolean",
            "x-labels": {
              "tr": "Alıcıyı Kaydet",
              "en": "Save Beneficiary"
            }
          },
          "beneficiaryAlias": {
            "type": "string",
            "x-labels": {
              "tr": "Alıcı Takma Adı",
              "en": "Beneficiary Alias"
            }
          },
          "isFirstTransfer": {
            "type": "boolean",
            "description": "True when no prior money-transfer instance exists for this targetIban. Set by the get-iban-history task; drives the push-approval branch.",
            "x-labels": {
              "tr": "İlk Transfer",
              "en": "First Transfer"
            }
          },
          "transferResult": {
            "type": "object",
            "description": "Result of the execute-transfer task. success drives the completed/failed branch.",
            "properties": {
              "success": {
                "type": "boolean",
                "x-labels": {
                  "tr": "Başarılı",
                  "en": "Success"
                }
              },
              "transferReference": {
                "type": "string",
                "x-labels": {
                  "tr": "İşlem Referansı",
                  "en": "Transfer Reference"
                }
              },
              "statusCode": {
                "type": "integer",
                "x-labels": {
                  "tr": "Durum Kodu",
                  "en": "Status Code"
                }
              }
            }
          }
        }
      },
      "InstanceResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "key": {
            "type": "string"
          },
          "flow": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "flowVersion": {
            "type": "string"
          },
          "eTag": {
            "type": "string"
          },
          "entityEtag": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          },
          "attributes": {
            "$ref": "#/components/schemas/MoneyTransferMasterData"
          },
          "extensions": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "InstanceDataResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/MoneyTransferMasterData"
          },
          "etag": {
            "type": "string"
          },
          "entityEtag": {
            "type": "string"
          },
          "extensions": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "MoneyTransferInputPayload": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:vnext:res:schema:core:money-transfer-input",
        "title": "Money Transfer Input",
        "description": "Transition payload the user fills to submit a money transfer.",
        "type": "object",
        "required": [
          "sourceAccountId",
          "targetIban",
          "amount",
          "currency"
        ],
        "properties": {
          "sourceAccountId": {
            "type": "string",
            "x-labels": {
              "tr": "Kaynak Hesap",
              "en": "Source Account"
            },
            "x-lov": {
              "source": "urn:vnext:fn:core:get-source-accounts",
              "valueField": "$.data[*].accountId",
              "displayField": "$.data[*].displayName"
            }
          },
          "targetIban": {
            "type": "string",
            "pattern": "^TR[0-9]{24}$",
            "x-labels": {
              "tr": "Alıcı IBAN",
              "en": "Target IBAN"
            },
            "x-lookup": {
              "source": "urn:vnext:fn:core:get-favorite-beneficiaries",
              "resultField": "$.data"
            }
          },
          "amount": {
            "type": "number",
            "minimum": 0.01,
            "x-labels": {
              "tr": "Tutar",
              "en": "Amount"
            }
          },
          "currency": {
            "type": "string",
            "enum": [
              "TRY",
              "USD",
              "EUR"
            ],
            "default": "TRY",
            "x-labels": {
              "tr": "Para Birimi",
              "en": "Currency"
            }
          },
          "saveBeneficiary": {
            "type": "boolean",
            "default": false,
            "x-labels": {
              "tr": "Alıcıyı Kaydet",
              "en": "Save Beneficiary"
            }
          },
          "beneficiaryAlias": {
            "type": "string",
            "x-labels": {
              "tr": "Alıcı Takma Adı",
              "en": "Beneficiary Alias"
            },
            "x-conditional": {
              "showIf": {
                "field": "saveBeneficiary",
                "operator": "equals",
                "value": true
              }
            }
          }
        }
      }
    },
    "parameters": {
      "Sync": {
        "name": "sync",
        "in": "query",
        "required": false,
        "schema": {
