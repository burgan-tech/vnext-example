{
  "ApplicationName": "vnext-core-test",
  "ConnectionStrings": {
    "Default": "Host=POSTGRES_HOST;Port=5432;Database=POSTGRES_DB;Username=postgres;Password=postgres;"
  },
  "HealthChecks": {
    "Database": {
      "CacheTtlSeconds": 60
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "vNextApi": {
    "BaseUrl": "http://localhost:5000",
    "ApiVersion": "1",
    "TimeoutSeconds": 60,
    "MaxRetryAttempts": 3,
    "RetryDelayMilliseconds": 1000,
    "CircuitBreakerFailureThreshold": 20,
    "CircuitBreakerTimeoutSeconds": 60,
    "EnableCircuitBreakerBypass": true,
    "InternalOperationHeader": "X-Internal-Operation",
    "ValidateSsl": false
  },
  "ResponseCompression": {
    "Enable": false
  },
  "Redis": {
    "Mode": "Standalone",
    "InstanceName": "workflow-api-core-test",
    "ConnectionTimeout": 5000,
    "DefaultDatabase": 0,
    "Password": "",
    "Ssl": false,
    "Standalone": {
      "EndPoints": [
        "REDIS_HOST:6379"
      ]
    },
    "RetryPolicy": {
      "MaxRetries": 3,
      "RetryTimeout": 1000
    }
  },
  "Telemetry": {
    "ServiceName": "vnext-app-core-test",
    "ServiceNamespace": "core",
    "ServiceVersion": "1.0.0",
    "TracingEnabled": false,
    "MetricsEnabled": false,
    "LoggingEnabled": false
  },
  "Kestrel": {
    "Limits": {
      "MaxRequestHeadersTotalSize": 65536,
      "MaxRequestHeaderCount": 200,
      "MaxRequestBodySize": 10485760
    }
  },
  "Aether": {
    "Outbox": {
      "Schema": "sys_queues"
    }
  },
  "BackgroundJob": {
    "WithHostedService": false,
    "Schema": "sys_queues",
    "MaxRetryCount": 3,
    "RetryBaseDelay": "00:00:30",
    "ArmingInterval": "00:00:10",
    "ArmingBatchSize": 100,
    "VisibilityTimeout": "00:05:00",
    "ArmingLeaseDuration": "00:00:30"
  },
  "AllowedHosts": "*",
  "ExecutionApi": {
    "AppId": "vnext-execution-app-core"
  },
  "Vault": {
    "Enabled": false
  },
  "ClickHouse": {
    "Enabled": false
  },
  "Scripting": {
    "Helpers": {
      "Enabled": true
    },
    "Sandbox": {
      "Enabled": true,
      "AllowUnsafe": false,
      "PluginDirectory": "/app/assemblies",
      "AllowedAssemblies": [
        "System.Private.CoreLib",
        "System.Runtime",
        "System.Collections",
        "System.Linq",
        "System.Linq.Expressions",
        "System.Text.RegularExpressions",
        "Microsoft.CSharp",
        "netstandard"
      ],
      "BannedNamespaces": []
    }
  },
  "WorkflowExecution": {
    "TransitionJobTimeoutSeconds": 300,
    "TransitionPerJob": true,
    "DirectEnqueueContinuations": true,
    "LatestOnlyInstanceLoading": true,
    "FailurePolicy": {
      "MaxRetries": 5,
      "IntervalSeconds": 30
    }
  },
  "Example": {
    "ApiBaseUrl": "http://MOCKLAB_HOST:5000"
  },
  "ResultRetry": {
    "MaxRetryAttempts": 3,
    "RetryDelayMilliseconds": 50,
    "UseJitter": true,
    "BackoffType": "Constant",
    "RetryOnErrorCodes": [
      "TransitionLocked",
      "Locked"
    ]
  },
  "ServiceDiscovery": {
    "Enabled": false
  },
  "Workflow": {
    "InstanceFiltering": {
      "EnforceMasterSchemaFiltering": true
    }
  },
  "StateFunctionCache": {
    "Enabled": true,
    "TtlSeconds": 60
  },
  "InstanceFunctionCache": {
    "Enabled": true,
    "DefaultTtlSeconds": 60
  },
  "Dapr": {
    "Notification": {
      "BindingPrefix": "vnext-notification",
      "DefaultOperation": "create",
      "TimeoutSeconds": 30
    }
  }
}
