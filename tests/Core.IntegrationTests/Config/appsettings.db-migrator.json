{
  "ApplicationName": "vnext-db-migrator",
  "ConnectionStrings": {
    "Default": "Host=POSTGRES_HOST;Port=5432;Database=POSTGRES_DB;Username=postgres;Password=postgres;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Runtime": {
    "EnableSchemaMigration": true
  },
  "Vault": {
    "Enabled": false
  },
  "Redis": {
    "Mode": "Standalone",
    "InstanceName": "workflow-api",
    "ConnectionTimeout": 5000,
    "DefaultDatabase": 0,
    "Password": "",
    "Ssl": false,
    "Standalone": {
      "EndPoints": ["REDIS_HOST:6379"]
    },
    "RetryPolicy": {
      "MaxRetries": 3,
      "RetryTimeout": 1000
    }
  },
  "Telemetry": {
    "ServiceName": "vnext-db-migrator",
    "ServiceNamespace": "BBT.Workflow.DbMigrator",
    "ServiceVersion": "1.0.0",
    "TracingEnabled": false,
    "MetricsEnabled": false,
    "LoggingEnabled": false
  }
}
