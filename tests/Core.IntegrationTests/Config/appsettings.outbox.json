{
  "ApplicationName": "vnext-outbox-core-test",
  "ConnectionStrings": {
    "Default": "Host=POSTGRES_HOST;Port=5432;Database=POSTGRES_DB;Username=postgres;Password=postgres;"
  },
  "Aether": {
    "Outbox": {
      "Schema": "sys_queues",
      "BatchSize": 100,
      "LeaseDuration": "00:00:30",
      "RetentionPeriod": "7.00:00:00",
      "MaxRetryCount": 5,
      "RetryBaseDelay": "00:00:05",
      "BusyPollingInterval": "00:00:00.100",
      "IdlePollingInterval": "00:00:01",
      "MaxPollingInterval": "00:00:05"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Telemetry": {
    "ServiceName": "vnext-outbox-core-test",
    "ServiceNamespace": "core",
    "ServiceVersion": "1.0.0",
    "TracingEnabled": false,
    "MetricsEnabled": false,
    "LoggingEnabled": false
  },
  "AllowedHosts": "*",
  "Vault": {
    "Enabled": false
  },
  "ResultRetry": {
    "MaxRetryAttempts": 3,
    "RetryDelayMilliseconds": 50,
    "UseJitter": true,
    "BackoffType": "Constant",
    "RetryOnErrorCodes": [
      "TransitionLocked",
      "Locked"
    ]
  }
}
