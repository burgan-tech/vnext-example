{
  "ApplicationName": "vnext-execution-core-test",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OrchestrationApi": {
    "AppId": "vnext-app-core"
  },
  "TriggerRetry": {
    "MaxRetryAttempts": 3,
    "RetryDelayMilliseconds": 2000,
    "RetryOnStatusCodes": [409],
    "UseJitter": true
  },
  "ResponseCompression": {
    "Enable": false
  },
  "Redis": {
    "Mode": "Standalone",
    "InstanceName": "workflow-api-core-test",
    "ConnectionTimeout": 5000,
    "DefaultDatabase": 0,
    "Password": "",
    "Ssl": false,
    "Standalone": {
      "EndPoints": [
        "REDIS_HOST:6379"
      ]
    },
    "RetryPolicy": {
      "MaxRetries": 3,
      "RetryTimeout": 1000
    }
  },
  "Telemetry": {
    "ServiceName": "vnext-execution-app-core-test",
    "ServiceNamespace": "BBT.Workflow.Execution",
    "ServiceVersion": "1.0.0",
    "TracingEnabled": false,
    "MetricsEnabled": false,
    "LoggingEnabled": false
  },
  "AllowedHosts": "*",
  "Vault": {
    "Enabled": false
  },
  "Dapr": {
    "Notification": {
      "ComponentName": "vnext-notification-binding",
      "DefaultOperation": "create",
      "TimeoutSeconds": 30
    }
  }
}
